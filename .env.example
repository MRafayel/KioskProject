# Copy to .env for local development. Never commit the copied file.
#
# A deployed kiosk does not rely on this file being discovered. The Windows
# service installer names it outright via PRINTING_KIOSK_ENV_FILE and sets
# PRINTING_KIOSK_SERVICE=true, because a service starts in C:\Windows\System32
# where the search for a workspace root finds nothing — and an agent that fell
# back to the defaults below would take money and print to a folder. Both are
# set by infrastructure/windows/install-agent-service.ps1; neither belongs here.
NODE_ENV=development
LOG_LEVEL=debug

API_HOST=127.0.0.1
API_PORT=3000
API_ORIGIN=http://127.0.0.1:3000
KIOSK_AGENT_HOST=127.0.0.1
KIOSK_AGENT_PORT=3100
KIOSK_ORIGIN=http://localhost:5173
UPLOAD_ORIGIN=http://localhost:5174
PUBLIC_UPLOAD_ORIGIN=http://localhost:5174

# Optional real-phone HTTPS. Paths are relative to the repository root.
# Set UPLOAD_ORIGIN and PUBLIC_UPLOAD_ORIGIN to the same HTTPS LAN URL first.
# DEV_HTTPS_CERT_PATH=.certs/dev.pem
# DEV_HTTPS_KEY_PATH=.certs/dev-key.pem

# Remote production PostgreSQL must use sslmode=verify-full and a trusted CA.
DATABASE_URL=postgresql://printing_kiosk:development-only@localhost:5432/printing_kiosk
REDIS_URL=redis://localhost:6379

OBJECT_STORAGE_DRIVER=s3
# These two credentials bootstrap the development-only MinIO container.
MINIO_ROOT_USER=development-user
MINIO_ROOT_PASSWORD=development-password-change-me
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=printing-kiosk-private
S3_ACCESS_KEY_ID=printing-kiosk-api
S3_SECRET_ACCESS_KEY=development-api-secret-change-me
# The document-processing worker uses a separate least-privilege principal.
S3_WORKER_ACCESS_KEY_ID=printing-kiosk-worker
S3_WORKER_SECRET_ACCESS_KEY=development-worker-secret-change-me
S3_FORCE_PATH_STYLE=true
# Local MinIO is synthetic-data-only and does not enable SSE. Production must
# set this to AES256 or aws:kms (and set S3_KMS_KEY_ID for a customer-managed key).
# S3_SERVER_SIDE_ENCRYPTION=AES256
# S3_KMS_KEY_ID=

# Development-only credentials. Generate a different value for every key with:
# openssl rand -base64 48
COOKIE_SIGNING_KEY=replace-with-at-least-32-random-bytes
UPLOAD_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
MOBILE_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
DEV_KIOSK_API_KEY=replace-with-a-random-development-key
DEV_KIOSK_ID=kiosk_dev_001

# Admin control plane. In production, inject these settings only into the API
# (and the break-glass pepper into the operator CLI when issuing codes), never
# into the kiosk agent or worker. Both peppers must differ from every other
# secret above and from each other: leaking the session pepper must not also let
# somebody forge a recovery credential.
ADMIN_SESSION_PEPPER=replace-with-at-least-32-random-bytes
ADMIN_BREAK_GLASS_PEPPER=replace-with-at-least-32-random-bytes
ADMIN_ORIGIN=http://localhost:5175
# The WebAuthn relying party. Credentials are bound to this identifier, so
# changing it invalidates every enrolled security key. It must equal the
# ADMIN_ORIGIN host or be a parent domain of it.
ADMIN_WEBAUTHN_RP_ID=localhost
ADMIN_WEBAUTHN_RP_NAME=Printing Kiosk Admin
ADMIN_SESSION_IDLE_MINUTES=15
ADMIN_SESSION_ABSOLUTE_MINUTES=240
ADMIN_STEP_UP_TTL_SECONDS=300
ADMIN_CHALLENGE_TTL_SECONDS=180
ADMIN_BREAK_GLASS_TTL_HOURS=2160
# The control plane's own database connection, as the least-privilege reader
# role. That role cannot write anything and cannot select a customer's
# filename, a content digest, a storage object key, a print manifest or any
# credential digest — which is what makes "the admin panel cannot reach
# document contents" a property of the database rather than of the code.
#
# Provision it, then point this at it. Once the URL is configured, provisioning
# can reuse its password; ADMIN_READ_DATABASE_PASSWORD remains available for
# first-time setup or an intentional credential rotation:
#   ADMIN_READ_DATABASE_PASSWORD=... pnpm db:admin-reader provision
#   # or, for an existing configured role: pnpm db:admin-reader provision
#   pnpm db:admin-reader verify
#
# Re-run both after every migration: a new table is denied until somebody
# decides otherwise, and `verify` is what tells you a decision is missing.
# Until `provision` has run, the panel's first query against a table added by
# that migration fails with PostgreSQL 42501, permission denied.
# Production requires this and requires it to differ from DATABASE_URL.
ADMIN_READ_DATABASE_URL=postgresql://printing_kiosk_admin_reader:replace-with-the-provisioned-password@localhost:5432/printing_kiosk

# The connection the admin panel's few operator actions write through.
#
# It holds INSERT on a short, reviewed list of append-only admin action tables
# and the audit log, and holds no UPDATE or DELETE on anything, anywhere.
# It cannot touch `refunds` or `payments` at all, which is what makes "an
# Operator cannot move money" a property of the database rather than of a code
# path, and it cannot UPDATE `print_jobs`, so nothing reachable from the panel
# can change what a device reported.
#
# Provision it, then point this at it. Once the URL is configured, provisioning
# can reuse its password; ADMIN_WRITE_DATABASE_PASSWORD remains available for
# first-time setup or an intentional credential rotation:
#   ADMIN_WRITE_DATABASE_PASSWORD=... pnpm db:admin-writer provision
#   # or, for an existing configured role: pnpm db:admin-writer provision
#   pnpm db:admin-writer verify
#
# Re-run both after every migration: a new table is forbidden until somebody
# decides otherwise, and `verify` is what tells you a decision is missing.
# Production requires this and requires it to differ from the other two.
ADMIN_WRITE_DATABASE_URL=postgresql://printing_kiosk_admin_writer:replace-with-the-provisioned-password@localhost:5432/printing_kiosk

SESSION_IDLE_TTL_MINUTES=10
SESSION_ABSOLUTE_TTL_MINUTES=30
IDEMPOTENCY_TTL_HOURS=24
MOBILE_CLIENT_TTL_MINUTES=10
MAX_FILE_BYTES=52428800
MAX_SESSION_UPLOAD_BYTES=52428800
# How many documents one session may carry. The settings contract and the print
# manifest both stop at 10. Set this to 1 for one document per session.
MAX_FILES_PER_SESSION=10
UPLOAD_TIMEOUT_SECONDS=120
MAX_DOCUMENT_PAGES=200
MAX_IMAGE_DIMENSION_PIXELS=20000
MAX_IMAGE_PIXELS=40000000
MAX_NORMALIZED_FILE_BYTES=104857600
MAX_PREVIEW_FILE_BYTES=2097152
PREVIEW_MAX_WIDTH_PIXELS=1600
PREVIEW_MAX_HEIGHT_PIXELS=2200

# Development calls the local processor container. Production must use a
# digest-pinned, non-root, no-network processor image and owned ClamAV.
DOCUMENT_PROCESSOR_ADAPTER=container
# DOCUMENT_PROCESSOR_IMAGE=registry.example/processor@sha256:<64-hex-digest>
DOCUMENT_PROCESSOR_URL=http://127.0.0.1:3200
DOCUMENT_PROCESSOR_AUTH_TOKEN=development-processor-auth-token-change-me
DOCUMENT_PROCESSOR_RESPONSE_MAX_BYTES=536870912
# Production should place worker scratch on encrypted, quota-limited ephemeral
# storage excluded from backups, indexing, and crash capture.
DOCUMENT_PROCESSOR_SCRATCH_DIR=.tmp/document-worker
MALWARE_SCANNER_ADAPTER=clamav
# FreshClam supports 1-50 update checks per day. The scanner reloads the
# shared definitions through its internal self-check without gaining egress.
CLAMAV_UPDATE_CHECKS_PER_DAY=12
# Definitions older than this are refused, and the updater withholds readiness
# until it has fetched something newer, so the stack never starts on a database
# the processor would reject. Accepts 1-168 hours.
CLAMAV_DEFINITION_MAX_AGE_HOURS=36
# Host values support non-Compose development; Compose overrides these inside
# the isolated processor network and does not expose clamd to the host.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
DOCUMENT_PROCESSING_CONCURRENCY=1
DOCUMENT_PROCESSOR_MAX_ATTEMPTS=3
DOCUMENT_PROCESSOR_TIMEOUT_SECONDS=120
DOCUMENT_PROCESSOR_LEASE_SECONDS=180
DOCUMENT_PROCESSOR_MEMORY_MIB=3072
DOCUMENT_PROCESSOR_CPU_MILLIS=1000
DOCUMENT_PROCESSOR_PIDS_LIMIT=64
DOCUMENT_PROCESSOR_SCRATCH_BYTES=2147483648
COMPLETED_FILE_RETENTION_MINUTES=15
FAILED_FILE_RETENTION_MINUTES=60

# Print settings and pricing bounds. These cap what one session can order; the
# published pricing rule set decides what it costs. A price quote never
# outlives the idle session window.
MAX_COPIES=10
MAX_SELECTED_PAGES=200
MAX_PRINTED_SIDES=1000
QUOTE_TTL_SECONDS=300

# Virtual printing. The mock printer writes one folder per operation into a
# private local directory, and the agent spools the print-ready document there
# only for as long as the print takes. A command lease must be shorter than the
# job it belongs to, and a job may not outlive its own session. The scenario
# control is how the deterministic device outcomes are driven without hardware;
# configuration validation refuses to enable it in production.
PRINTER_ADAPTER=mock
PRINTER_MOCK_OUTPUT_DIR=./var/mock-printer/output
PRINTER_SPOOL_DIR=./.tmp/kiosk-agent-spool
# The device plane. A kiosk prints only to a queue an operator certified by
# name: an empty allowlist approves nothing, and a machine offering two
# certified queues with no stated preference refuses rather than guessing which
# room the paper comes out in. `windows` accepts only the local USB device host
# described in
# docs/hardware/windows-device-host.md. Production refuses `mock` outright.
PRINTER_QUEUE_ALLOWLIST=Mock Kiosk Printer
PRINTER_QUEUE_NAME=
PRINTER_ALLOW_SHARED_QUEUE=false
PRINTER_WINDOWS_HOST_PATH=
# Which printer/driver combinations an operator certified, as JSON:
#   [{"driverName":"Canon Generic Plus UFR II","portPattern":"^USB\\d+$"}]
# Empty keeps the reference printer, so approving a second model is a
# configuration change rather than an edit to the device host on every kiosk.
# Local and unshared is not negotiable here — it is the boundary the host
# enforces regardless of what a profile says.
PRINTER_DEVICE_PROFILES=
# The agent's record of what it handed to a device. It is what separates "never
# submitted" from "submitted and forgotten", so it lives on the kiosk machine
# and has to survive a restart there.
PRINTER_DEVICE_JOURNAL_DIR=./.tmp/kiosk-agent-device
# How often the agent reports that it is alive and re-reads what the printer
# can do, so a swapped printer is noticed within one beat rather than at the
# next print. It must be shorter than a print command lease.
AGENT_HEARTBEAT_SECONDS=30
PRINT_JOB_TIMEOUT_SECONDS=300
PRINT_COMMAND_LEASE_SECONDS=120
PRINT_COMMAND_MAX_ATTEMPTS=2
PRINT_DISPATCH_MAX_ATTEMPTS=5
PRINT_TEST_OUTCOMES_ENABLED=true
# The device's own copy of what it printed is the evidence a redelivered
# operation is resolved against, so it must outlive the job it belongs to.
# After that it is only a copy of a customer's document and the agent's local
# watchdog discards it, with or without a reachable control plane.
PRINTER_OUTPUT_RETENTION_SECONDS=900

# The printer's own telemetry, over its dedicated link.
#
# Off by default, and off means the kiosk reports whatever the print driver says
# about the device. On the certified Canon that is `Normal` with an empty tray —
# the driver cannot see paper — so a kiosk left on the default sells prints it
# cannot produce. Any deployment with the telemetry cable attached must turn
# this on; nothing else in this file re-enables it.
PRINTER_TELEMETRY_ENABLED=false
# The printer's address on the telemetry link. Must be a private IPv4 literal —
# a hostname is refused, because resolving one is a dependency this link does
# not have.
PRINTER_TELEMETRY_HOST=
PRINTER_TELEMETRY_PORT=161
# Identity, checked on every reading before any of the reading is believed. A
# device that answers to a different serial or MAC has its whole reply discarded
# rather than half-trusted. The serial is `prtGeneralSerialNumber`; the MAC is
# six colon-separated hex octets and may be left empty if the link cannot see it.
PRINTER_TELEMETRY_SERIAL=
PRINTER_TELEMETRY_MAC=
# SNMPv3 authPriv. There is no v1/v2c path: the community string would travel in
# clear on a cable inside a public machine's enclosure.
#
# The two passphrases must differ. They are localised into separate keys, and
# reusing one passphrase for both means a single compromise yields both.
# MIB access on the printer must be Read Only — a stolen credential then buys
# telemetry reads on an isolated cable and nothing else.
PRINTER_TELEMETRY_SNMP_USER=
PRINTER_TELEMETRY_SNMP_AUTH_PROTOCOL=sha256
PRINTER_TELEMETRY_SNMP_AUTH_KEY=
PRINTER_TELEMETRY_SNMP_PRIV_PROTOCOL=aes
PRINTER_TELEMETRY_SNMP_PRIV_KEY=
# Which local address to send from, when the kiosk has more than one interface
# and only one of them faces the printer. Empty lets the OS route.
PRINTER_TELEMETRY_SOURCE_ADDRESS=
# Whether sustained telemetry silence withdraws the printer's health. On means a
# kiosk that has lost sight of its printer stops selling rather than selling
# blind; off restores the pre-telemetry behaviour and is the documented opt-out.
PRINTER_TELEMETRY_REQUIRED=true
# The poller runs on its own schedule so a printer that has stopped answering
# can never delay the heartbeat that proves this machine is alive.
PRINTER_TELEMETRY_POLL_SECONDS=30
PRINTER_TELEMETRY_TIMEOUT_MS=1000
PRINTER_TELEMETRY_BUDGET_MS=5000
# The certified Canon drops roughly one request in eight, so a single attempt
# would report silence on a printer that is answering fine.
PRINTER_TELEMETRY_ATTEMPTS=2
# How old the reading behind a healthy verdict may be at the last check before
# money moves. Payment enforces this; session start does not, because refusing a
# customer at the welcome screen over a poll that is merely due costs a print and
# prevents nothing.
#
# Must exceed PRINTER_TELEMETRY_POLL_SECONDS + AGENT_HEARTBEAT_SECONDS — between
# changes the stored reading ages by both, and a tighter ceiling makes healthy
# kiosks refuse payments on a schedule. Startup refuses a value that cannot work.
PRINTER_TELEMETRY_MAX_AGE_SECONDS=90

# Retention. A session that ended without reaching a device deletes its
# documents immediately; only an outcome somebody may still ask about is given
# a grace, and it is measured in minutes. A cleanup run that has failed
# RETENTION_MAX_ATTEMPTS times is dead-lettered and logged as an alert rather
# than closed, because the documents are still there. The orphan grace is how
# old a stray object must be before the reconciler will call it nobody's; it
# has to outlive the longest-lived session, and configuration validation
# enforces that.
RETENTION_SETTLED_GRACE_SECONDS=300
RETENTION_RECOVERY_GRACE_SECONDS=900
RETENTION_SWEEP_INTERVAL_SECONDS=30
RETENTION_LEASE_SECONDS=120
RETENTION_MAX_ATTEMPTS=8
RETENTION_ORPHAN_GRACE_SECONDS=7200

# Simulated payment. The webhook secret signs and verifies provider callbacks
# and must be a distinct value from every other key in production. The payment
# window can never outlive the price it is paying, so it is capped by
# QUOTE_TTL_SECONDS. The outcome-control route is how the deterministic
# provider scenarios are driven without card hardware; configuration
# validation refuses to enable it in production.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=development-only-payment-webhook-secret-change-me
PAYMENT_TIMEOUT_SECONDS=180
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_TEST_OUTCOMES_ENABLED=true
