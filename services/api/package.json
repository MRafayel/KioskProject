{
  "name": "@printing-kiosk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1086.0",
    "@aws-sdk/lib-storage": "3.1086.0",
    "@fastify/cookie": "11.1.1",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@printing-kiosk/admin-access": "workspace:*",
    "@printing-kiosk/config": "workspace:*",
    "@printing-kiosk/contracts": "workspace:*",
    "@printing-kiosk/database": "workspace:*",
    "@printing-kiosk/domain": "workspace:*",
    "@printing-kiosk/file-processing": "workspace:*",
    "@printing-kiosk/payment-adapters": "workspace:*",
    "@printing-kiosk/pricing": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "bullmq": "5.80.2",
    "fastify": "5.10.0",
    "socket.io": "4.8.3",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src scripts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "test": "vitest run src",
    "admin-benchmark": "tsx scripts/admin-read-benchmark.ts"
  },
  "devDependencies": {
    "tsx": "4.23.12"
  }
}
