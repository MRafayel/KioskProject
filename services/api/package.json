{
  "name": "@printing-kiosk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1086.0",
    "@aws-sdk/lib-storage": "3.1086.0",
    "@fastify/cookie": "11.1.1",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@printing-kiosk/config": "workspace:*",
    "@printing-kiosk/contracts": "workspace:*",
    "@printing-kiosk/database": "workspace:*",
    "@printing-kiosk/domain": "workspace:*",
    "@printing-kiosk/file-processing": "workspace:*",
    "fastify": "5.10.0",
    "zod": "4.4.3"
