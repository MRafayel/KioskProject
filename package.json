{
  "name": "printing-kiosk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm build:packages && turbo run dev",
    "dev:kiosk": "pnpm build:packages && turbo run dev --filter=@printing-kiosk/api --filter=@printing-kiosk/kiosk-agent --filter=@printing-kiosk/kiosk --filter=@printing-kiosk/mobile-upload --filter=@printing-kiosk/worker",
    "build:packages": "turbo run build --filter='./packages/*'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm build:packages && vitest run tests/integration --passWithNoTests --no-file-parallelism",
    "test:e2e": "pnpm --filter @printing-kiosk/kiosk test:e2e && pnpm --filter @printing-kiosk/mobile-upload test:e2e && vitest run tests/e2e --passWithNoTests",
    "infra:up": "node scripts/docker.mjs compose -f infrastructure/compose/dev.yml up -d --build",
    "infra:down": "node scripts/docker.mjs compose -f infrastructure/compose/dev.yml down",
    "infra:status": "node scripts/docker.mjs compose -f infrastructure/compose/dev.yml ps",
    "infra:logs": "node scripts/docker.mjs compose -f infrastructure/compose/dev.yml logs --tail=200",
    "infra:validate": "node scripts/docker.mjs compose -f infrastructure/compose/dev.yml config --quiet",
    "db:generate": "pnpm --filter @printing-kiosk/database generate",
    "db:migrate": "pnpm --filter @printing-kiosk/database migrate",
    "db:seed": "pnpm --filter @printing-kiosk/database seed",
    "db:verify-phase5-upgrade": "pnpm --filter @printing-kiosk/database verify:phase5-upgrade",
    "db:verify-phase6-upgrade": "pnpm --filter @printing-kiosk/database verify:phase6-upgrade",
    "db:verify-phase7-upgrade": "pnpm --filter @printing-kiosk/database verify:phase7-upgrade",
    "db:verify-phase8-upgrade": "pnpm --filter @printing-kiosk/database verify:phase8-upgrade",
    "db:verify-phase9-upgrade": "pnpm --filter @printing-kiosk/database verify:phase9-upgrade"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1086.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "socket.io-client": "4.8.3",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
