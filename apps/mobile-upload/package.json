{
  "name": "@printing-kiosk/mobile-upload",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@printing-kiosk/contracts": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0 --port 5174",
    "lint": "eslint src e2e vite.config.ts playwright.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src --passWithNoTests",
    "test:e2e": "tsc -b && vite build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "vite": "8.1.4"
  }
}
