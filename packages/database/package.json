{
  "name": "@printing-kiosk/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "generate": "prisma generate",
    "lint": "eslint src scripts prisma.config.ts",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "verify:phase5-upgrade": "node scripts/verify-phase5-upgrade.mjs",
    "verify:phase6-upgrade": "node scripts/verify-phase6-upgrade.mjs",
    "verify:phase7-upgrade": "node scripts/verify-phase7-upgrade.mjs",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests",
    "verify:phase8-upgrade": "node scripts/verify-phase8-upgrade.mjs",
    "verify:phase9-upgrade": "node scripts/verify-phase9-upgrade.mjs"
  },
  "dependencies": {
    "@printing-kiosk/domain": "workspace:*",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "17.4.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.21.0",
    "prisma": "7.9.1",
    "tsx": "4.23.11"
  }
}
