generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model SystemMetadata {
  key       String   @id @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_metadata")
}

model Kiosk {
  id                  String            @id @db.VarChar(64)
  publicCode          String            @unique @map("public_code") @db.VarChar(64)
  name                String            @db.VarChar(160)
  status              String            @default("ACTIVE") @db.VarChar(32)
  timezone            String            @default("Asia/Yerevan") @db.VarChar(64)
  /// What the attached device says it can do. A capability report replaces this
  /// wholesale, because the device is the only authority on it.
  capabilities        Json
  /// The operator's queue certification, and the one thing on this row a device
  /// may not write. It lived inside `capabilities` until a capability report was
  /// found to overwrite that column entire, silently deleting the allowlist and
  /// leaving the kiosk unable to approve any printer again. Its own column is
  /// what makes that class of accident impossible rather than merely avoided.
  approvedQueues      String[]          @default([]) @map("approved_queues")
  capabilitiesVersion Int               @default(1) @map("capabilities_version")
  configVersion       Int               @default(1) @map("config_version")
  lastSeenAt          DateTime?         @map("last_seen_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  credentials         KioskCredential[]
  sessions            PrintSession[]
  sessionEvents       SessionEvent[]
  printJobs           PrintJob[]
  agentCommands       AgentCommand[]
  adminScopes         AdminKioskScope[]
  agents              KioskAgent[]
  printers            Printer[]

  @@index([status])
  @@index([lastSeenAt])
  @@map("kiosks")
}

/// One installation of the local agent. A kiosk normally has exactly one; the
/// row exists so a fleet can see whether it is alive, what it is running, and
/// which printer it says it is bound to, without the kiosk opening any port.
model KioskAgent {
  id               String    @id @db.Uuid
  kioskId          String    @map("kiosk_id") @db.VarChar(64)
  /// Stable per installation, so a restarted agent is the same agent.
  agentId          String    @unique @map("agent_id") @db.Uuid
  agentVersion     String    @map("agent_version") @db.VarChar(64)
  platform         String    @db.VarChar(16)
  platformRelease  String?   @map("platform_release") @db.VarChar(120)
  adapter          String    @db.VarChar(16)
  /// The queue the agent last said it was bound to. Null when it bound none.
  queueName        String?   @map("queue_name") @db.VarChar(220)
  printerHealth    String    @default("OFFLINE") @map("printer_health") @db.VarChar(16)
  /// The digest of the capability snapshot this agent last reported.
  capabilityHash   String?   @map("capability_hash") @db.VarChar(64)
  activeOperations Int       @default(0) @map("active_operations")
  registeredAt     DateTime  @default(now()) @map("registered_at")
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  kiosk            Kiosk     @relation(fields: [kioskId], references: [id], onDelete: Cascade)

  @@index([kioskId, lastHeartbeatAt])
  @@map("kiosk_agents")
}

/// One print queue a kiosk machine offers.
///
/// Every discovered queue gets a row, not only the certified one: an operator
/// certifying a kiosk needs to see what is actually installed on it, and a
/// queue that appeared without anybody adding it is exactly what a fleet view
/// should be able to show. Only the approved row carries capabilities, because
/// capabilities are what a customer is offered and a quote is bound to.
model Printer {
  id             String    @id @db.Uuid
  kioskId        String    @map("kiosk_id") @db.VarChar(64)
  queueName      String    @map("queue_name") @db.VarChar(220)
  adapter        String    @db.VarChar(16)
  approval       String    @default("NOT_APPROVED") @db.VarChar(16)
  queueState     String    @default("ERROR") @map("queue_state") @db.VarChar(16)
  isDefault      Boolean   @default(false) @map("is_default")
  shared         Boolean   @default(false)
  deviceUri      String?   @map("device_uri") @db.VarChar(400)
  driverName     String?   @map("driver_name") @db.VarChar(400)
  portName       String?   @map("port_name") @db.VarChar(400)
  deviceId       String?   @map("device_id") @db.VarChar(400)
  /// The physical printer, not the driver that happens to drive it.
  makeAndModel   String?   @map("make_and_model") @db.VarChar(400)
  /// The installed driver's version, which used to be stored as firmware.
  driverVersion  String?   @map("driver_version") @db.VarChar(400)
  firmware       String?   @db.VarChar(400)
  health         String    @default("OFFLINE") @db.VarChar(16)
  warningCode    String?   @map("warning_code") @db.VarChar(32)
  capabilities   Json?
  capabilityHash String?   @map("capability_hash") @db.VarChar(64)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  lastHealthyAt  DateTime? @map("last_healthy_at")
  /// When the printer's own telemetry was last actually read — not when the
  /// agent last spoke. `lastSeenAt` proves the kiosk is alive and is refreshed
  /// every heartbeat whether or not the printer answered, so it cannot tell a
  /// one-second-old SNMP reading from a one-minute-old one. Payment needs that
  /// difference; `null` means this printer has no telemetry link at all.
  telemetryAt    DateTime? @map("telemetry_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  kiosk          Kiosk     @relation(fields: [kioskId], references: [id], onDelete: Cascade)

  @@unique([kioskId, queueName])
  @@index([kioskId, approval])
  @@map("printers")
}

model KioskCredential {
  id           String    @id @db.Uuid
  kioskId      String    @map("kiosk_id") @db.VarChar(64)
  credentialId String    @unique @map("credential_id") @db.VarChar(100)
  secretDigest String    @unique @map("secret_digest") @db.VarChar(64)
  scopes       String[]
  issuedAt     DateTime  @default(now()) @map("issued_at")
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  kiosk        Kiosk     @relation(fields: [kioskId], references: [id], onDelete: Cascade)

  @@index([kioskId, revokedAt])
  @@map("kiosk_credentials")
}

model PrintSession {
  id                      String                 @id @db.Uuid
  publicId                String                 @unique @map("public_id") @db.VarChar(80)
  kioskId                 String                 @map("kiosk_id") @db.VarChar(64)
  locale                  String                 @db.VarChar(10)
  state                   String                 @db.VarChar(40)
  stateVersion            Int                    @default(1) @map("state_version")
  eventSequence           Int                    @default(1) @map("event_sequence")
  currentSettingsRevision Int?                   @map("current_settings_revision")
  activeQuoteId           String?                @unique @map("active_quote_id") @db.Uuid
  idleExpiresAt           DateTime               @map("idle_expires_at")
  hardExpiresAt           DateTime               @map("hard_expires_at")
  terminalReason          String?                @map("terminal_reason") @db.VarChar(80)
  /// Mirrors the cleanup run so operators can find overdue retention from one
  /// row. NOT_DUE until the session ends.
  cleanupStatus           String                 @default("NOT_DUE") @map("cleanup_status") @db.VarChar(24)
  cleanupDueAt            DateTime?              @map("cleanup_due_at")
  /// The tombstone. Set only by a cleanup run that proved nothing is left, and
  /// enforced by a trigger that consults the artifact ledger.
  filesDeletedAt          DateTime?              @map("files_deleted_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @default(now()) @updatedAt @map("updated_at")
  canceledAt              DateTime?              @map("canceled_at")
  expiredAt               DateTime?              @map("expired_at")
  completedAt             DateTime?              @map("completed_at")
  kiosk                   Kiosk                  @relation(fields: [kioskId], references: [id], onDelete: Restrict)
  activeQuote             PriceQuote?            @relation("SessionActiveQuote", fields: [activeQuoteId], references: [id], onDelete: SetNull)
  uploadGrants            SessionUploadGrant[]
  mobileClients           MobileClient[]
  uploadedFiles           UploadedFile[]
  settingRevisions        PrintSettingRevision[]
  priceQuotes             PriceQuote[]           @relation("SessionQuotes")
  payments                Payment[]
  refunds                 Refund[]
  printJobs               PrintJob[]
  agentCommands           AgentCommand[]
  outboxEvents            OutboxEvent[]
  sessionEvents           SessionEvent[]
  cleanupRun              CleanupRun?
  recoveryResolutions     PrintJobRecoveryResolution[]
  recoveryCorrections     PrintJobRecoveryCorrection[]
  refundAuthorizations    RefundAuthorization[]

  @@index([kioskId, createdAt])
  @@index([state, idleExpiresAt])
  @@index([state, hardExpiresAt])
  @@index([cleanupStatus, cleanupDueAt])
  @@map("print_sessions")
}

/// One session's document deletion, as a resumable workflow rather than a row
/// update. It records the last checkpoint that succeeded, so an interrupted
/// run repeats from there instead of starting over, and a lease keeps two
/// workers from deleting the same objects at once. A run is never quietly
/// abandoned: when its attempts are spent it is dead-lettered for a person,
/// because the documents are still there.
model CleanupRun {
  id                      String       @id @db.Uuid
  sessionId               String       @unique @map("session_id") @db.Uuid
  reason                  String       @db.VarChar(40)
  status                  String       @default("PENDING") @db.VarChar(24)
  checkpoint              String       @default("SCHEDULED") @db.VarChar(32)
  attempts                Int          @default(0)
  availableAt             DateTime     @default(now()) @map("available_at")
  leaseToken              String?      @unique @map("lease_token") @db.Uuid
  leaseExpiresAt          DateTime?    @map("lease_expires_at")
  lastErrorCode           String?      @map("last_error_code") @db.VarChar(80)
  objectsDeleted          Int          @default(0) @map("objects_deleted")
  orphanObjectsDeleted    Int          @default(0) @map("orphan_objects_deleted")
  multipartUploadsAborted Int          @default(0) @map("multipart_uploads_aborted")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at")
  startedAt               DateTime?    @map("started_at")
  completedAt             DateTime?    @map("completed_at")
  deadLetteredAt          DateTime?    @map("dead_lettered_at")
  session                 PrintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  retryRequests           CleanupRetryRequest[]

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@map("cleanup_runs")
}

/// Immutable pricing snapshot. A quote, payment and print job refer to one
/// exact revision; the sole later amendment is the database-guarded removal of
/// per-document content digests after the session becomes terminal.
model PrintSettingRevision {
  id                 String       @id @db.Uuid
  sessionId          String       @map("session_id") @db.Uuid
  revision           Int
  /// Copies, duplex and orientation live on each `selections` entry: they
  /// describe one document, and a session prints several.
  paperSize          String       @map("paper_size") @db.VarChar(16)
  scaling            String       @db.VarChar(16)
  collate            Boolean
  colorMode          String       @map("color_mode") @db.VarChar(16)
  selections         Json
  /// Set once by retention when raw per-document content digests are removed
  /// from selections. All priced paper/range aggregates remain immutable.
  selectionsRedactedAt DateTime?  @map("selections_redacted_at")
  selectedPages      Int          @map("selected_pages")
  printedSides       Int          @map("printed_sides")
  physicalSheets     Int          @map("physical_sheets")
  capabilityVersion  Int          @map("capability_version")
  manifestHash       String       @map("manifest_hash") @db.VarChar(64)
  createdByActorType String       @map("created_by_actor_type") @db.VarChar(32)
  createdByActorId   String       @map("created_by_actor_id") @db.VarChar(100)
  createdAt          DateTime     @default(now()) @map("created_at")
  session            PrintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  quotes             PriceQuote[]
  printJobs          PrintJob[]

  @@unique([sessionId, revision])
  @@index([sessionId, createdAt])
  @@map("print_setting_revisions")
}

/// A published rule set is immutable. Corrections create another version.
model PricingRuleSet {
  id                 String        @id @db.Uuid
  version            String        @unique @db.VarChar(40)
  scope              String        @db.VarChar(24)
  scopeRef           String        @default("") @map("scope_ref") @db.VarChar(64)
  currency           String        @db.Char(3)
  currencyExponent   Int           @map("currency_exponent")
  status             String        @db.VarChar(16)
  rounding           String        @db.VarChar(16)
  taxMode            String        @map("tax_mode") @db.VarChar(16)
  minimumApplication String        @map("minimum_application") @db.VarChar(16)
  validFrom          DateTime      @map("valid_from")
  validUntil         DateTime?     @map("valid_until")
  publishedAt        DateTime?     @map("published_at")
  archivedAt         DateTime?     @map("archived_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at")
  rules              PricingRule[]
  quotes             PriceQuote[]
  /// The approval that published it, when a person published it. Null for a
  /// tariff a deployment seeded.
  changeExecution    AdminChangeExecution?

  @@index([status, validFrom])
  @@map("pricing_rule_sets")
}

model PricingRule {
  id                          String         @id @db.Uuid
  ruleSetId                   String         @map("rule_set_id") @db.Uuid
  service                     String         @db.VarChar(24)
  paperSize                   String         @map("paper_size") @db.VarChar(16)
  colorMode                   String         @map("color_mode") @db.VarChar(16)
  unitAmountMinor             Int            @map("unit_amount_minor")
  duplexAdjustmentBasisPoints Int            @map("duplex_adjustment_basis_points")
  serviceFeeMinor             Int            @map("service_fee_minor")
  minimumAmountMinor          Int            @map("minimum_amount_minor")
  taxBasisPoints              Int            @map("tax_basis_points")
  priority                    Int            @default(0)
  createdAt                   DateTime       @default(now()) @map("created_at")
  ruleSet                     PricingRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([ruleSetId, service, paperSize, colorMode])
  @@map("pricing_rules")
}

model PriceQuote {
  id                     String               @id @db.Uuid
  sessionId              String               @map("session_id") @db.Uuid
  settingsRevision       Int                  @map("settings_revision")
  manifestHash           String               @map("manifest_hash") @db.VarChar(64)
  ruleSetId              String               @map("rule_set_id") @db.Uuid
  pricingVersion         String               @map("pricing_version") @db.VarChar(40)
  status                 String               @db.VarChar(16)
  currency               String               @db.Char(3)
  currencyExponent       Int                  @map("currency_exponent")
  selectedPages          Int                  @map("selected_pages")
  printedSides           Int                  @map("printed_sides")
  physicalSheets         Int                  @map("physical_sheets")
  printAmountMinor       Int                  @map("print_amount_minor")
  duplexAdjustmentMinor  Int                  @map("duplex_adjustment_minor")
  serviceFeeMinor        Int                  @map("service_fee_minor")
  minimumAdjustmentMinor Int                  @map("minimum_adjustment_minor")
  subtotalMinor          Int                  @map("subtotal_minor")
  taxMinor               Int                  @map("tax_minor")
  totalMinor             Int                  @map("total_minor")
  expiresAt              DateTime             @map("expires_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  invalidatedAt          DateTime?            @map("invalidated_at")
  invalidationReason     String?              @map("invalidation_reason") @db.VarChar(32)
  session                PrintSession         @relation("SessionQuotes", fields: [sessionId], references: [id], onDelete: Cascade)
  settings               PrintSettingRevision @relation(fields: [sessionId, settingsRevision], references: [sessionId, revision], onDelete: Cascade)
  ruleSet                PricingRuleSet       @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  activeForSession       PrintSession?        @relation("SessionActiveQuote")
  payments               Payment[]
  printJobs              PrintJob[]

  @@unique([id, sessionId])
  @@index([sessionId, createdAt])
  @@index([status, expiresAt])
  @@map("price_quotes")
}

/// The accounting record for one attempt to collect one quote's total.
/// Amount and currency are re-checked against the quote by a trigger, so a
/// payment can never be stored for a price the control plane did not issue.
model Payment {
  id                 String                @id @db.Uuid
  sessionId          String                @map("session_id") @db.Uuid
  quoteId            String                @map("quote_id") @db.Uuid
  provider           String                @db.VarChar(24)
  providerIntentId   String                @map("provider_intent_id") @db.VarChar(120)
  status             String                @db.VarChar(24)
  /// True only when this capture moved the session to PAID. A late capture is
  /// still CAPTURED in the accounting ledger, but remains false because it is
  /// owed back rather than fulfilled.
  appliedToSession   Boolean               @default(false) @map("applied_to_session")
  amountMinor        Int                   @map("amount_minor")
  currency           String                @db.Char(3)
  currencyExponent   Int                   @map("currency_exponent")
  settingsRevision   Int                   @map("settings_revision")
  manifestHash       String                @map("manifest_hash") @db.VarChar(64)
  failureCode        String?               @map("failure_code") @db.VarChar(48)
  createdByActorType String                @map("created_by_actor_type") @db.VarChar(32)
  createdByActorId   String                @map("created_by_actor_id") @db.VarChar(100)
  expiresAt          DateTime              @map("expires_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at")
  authorizedAt       DateTime?             @map("authorized_at")
  capturedAt         DateTime?             @map("captured_at")
  failedAt           DateTime?             @map("failed_at")
  session            PrintSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  quote              PriceQuote            @relation(fields: [quoteId, sessionId], references: [id, sessionId], onDelete: Restrict)
  attempts           PaymentAttempt[]
  webhookEvents      PaymentWebhookInbox[]
  refunds            Refund[]
  printJobs          PrintJob[]

  @@unique([id, sessionId])
  @@unique([provider, providerIntentId])
  @@index([sessionId, createdAt])
  @@index([status, expiresAt])
  @@map("payments")
}

/// One row per provider interaction. Append-only: a retry writes the next
/// attempt rather than rewriting the previous one.
model PaymentAttempt {
  id                   String   @id @db.Uuid
  paymentId            String   @map("payment_id") @db.Uuid
  attempt              Int
  action               String   @db.VarChar(24)
  status               String   @db.VarChar(24)
  providerReference    String?  @map("provider_reference") @db.VarChar(120)
  failureCode          String?  @map("failure_code") @db.VarChar(48)
  idempotencyKeyDigest String?  @map("idempotency_key_digest") @db.VarChar(64)
  createdAt            DateTime @default(now()) @map("created_at")
  payment              Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, attempt])
  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

/// Every verified callback is recorded before it is acted on. The provider
/// event identifier is unique, so a duplicate delivery is acknowledged and
/// ignored instead of capturing twice.
model PaymentWebhookInbox {
  id               String    @id @db.Uuid
  provider         String    @db.VarChar(24)
  providerEventId  String    @map("provider_event_id") @db.VarChar(120)
  providerIntentId String    @map("provider_intent_id") @db.VarChar(120)
  paymentId        String?   @map("payment_id") @db.Uuid
  eventType        String    @map("event_type") @db.VarChar(48)
  payloadDigest    String    @map("payload_digest") @db.VarChar(64)
  result           String    @db.VarChar(32)
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")
  payment          Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId, receivedAt])
  @@map("payment_webhook_inbox")
}

/// A compensation record. It never rewrites the capture it refers to: money
/// that moved stays recorded, and this row is the obligation to return it.
model Refund {
  id               String       @id @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  sessionId        String       @map("session_id") @db.Uuid
  provider         String       @db.VarChar(24)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(120)
  reason           String       @db.VarChar(32)
  amountMinor      Int          @map("amount_minor")
  currency         String       @db.Char(3)
  currencyExponent Int          @map("currency_exponent")
  status           String       @db.VarChar(24)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")
  completedAt      DateTime?    @map("completed_at")
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  session          PrintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorization    RefundAuthorization?

  @@unique([paymentId, reason])
  @@index([status, createdAt])
  @@map("refunds")
}

/// One paid session's print job. The manifest, the counts and the money it was
/// paid with are frozen at creation: triggers refuse to rewrite the snapshot,
/// refuse a job without a capture applied to its own session, and refuse to
/// move a settled job. There is at most one per session.
model PrintJob {
  id                   String               @id @db.Uuid
  sessionId            String               @map("session_id") @db.Uuid
  kioskId              String               @map("kiosk_id") @db.VarChar(64)
  quoteId              String               @map("quote_id") @db.Uuid
  paymentId            String               @map("payment_id") @db.Uuid
  settingsRevision     Int                  @map("settings_revision")
  settingsManifestHash String               @map("settings_manifest_hash") @db.VarChar(64)
  jobManifest          Json                 @map("job_manifest")
  jobManifestHash      String               @map("job_manifest_hash") @db.VarChar(64)
  status               String               @db.VarChar(24)
  /// Acceptance by a queue is not proof that paper came out. UNCONFIRMED is a
  /// real answer and is never rounded up to a success.
  resultConfidence     String               @default("UNKNOWN") @map("result_confidence") @db.VarChar(16)
  failureCode          String?              @map("failure_code") @db.VarChar(48)
  warningCode          String?              @map("warning_code") @db.VarChar(32)
  /// Development only; a production configuration cannot set it.
  simulatedOutcome     String?              @map("simulated_outcome") @db.VarChar(32)
  /// Set once by retention, when the per-document digests in `jobManifest` are
  /// replaced by a count. The manifest hash and the outcome stay: what was paid
  /// for and what the device reported is evidence; which files it was is not.
  manifestRedactedAt   DateTime?            @map("manifest_redacted_at")
  copies               Int
  printedSides         Int                  @map("printed_sides")
  physicalSheets       Int                  @map("physical_sheets")
  sheetsProduced       Int?                 @map("sheets_produced")
  dispatchAttempts     Int                  @default(0) @map("dispatch_attempts")
  availableAt          DateTime             @default(now()) @map("available_at")
  deadlineAt           DateTime             @map("deadline_at")
  cancelRequestedAt    DateTime?            @map("cancel_requested_at")
  createdByActorType   String               @map("created_by_actor_type") @db.VarChar(32)
  createdByActorId     String               @map("created_by_actor_id") @db.VarChar(100)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at")
  dispatchedAt         DateTime?            @map("dispatched_at")
  startedAt            DateTime?            @map("started_at")
  completedAt          DateTime?            @map("completed_at")
  failedAt             DateTime?            @map("failed_at")
  session              PrintSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kiosk                Kiosk                @relation(fields: [kioskId], references: [id], onDelete: Restrict)
  payment              Payment              @relation(fields: [paymentId, sessionId], references: [id, sessionId], onDelete: Restrict)
  quote                PriceQuote           @relation(fields: [quoteId, sessionId], references: [id, sessionId], onDelete: Restrict)
  settings             PrintSettingRevision @relation(fields: [sessionId, settingsRevision], references: [sessionId, revision], onDelete: Restrict)
  events               PrintJobEvent[]
  commands             AgentCommand[]
  recoveryResolution   PrintJobRecoveryResolution?
  recoveryCorrections  PrintJobRecoveryCorrection[]
  refundAuthorization  RefundAuthorization?

  @@unique([sessionId], map: "print_jobs_one_per_session_idx")
  @@index([status, availableAt])
  @@index([status, deadlineAt])
  @@index([kioskId, createdAt])
  @@map("print_jobs")
}

/// What a person saw at the tray for a job the system refused to guess about.
///
/// This is a new fact, not an edit. `print_jobs` records what the device
/// reported and triggers refuse to rewrite it, so a human observation is stored
/// beside that record rather than over it — which is also why an operator can
/// never turn an ambiguous print into a success.
///
/// One per job, and append-only. A mistaken observation stays visible and is
/// answered by a later decision with more authority, because an operator who
/// could rewrite their own account of a paid print could hide one.
///
/// It cannot move money. `refundSuggested` is a note for whoever holds
/// `refund.authorize`; the obligation itself lives in `refunds`, which the role
/// that writes this table holds no privilege on at all.
model PrintJobRecoveryResolution {
  id                String       @id @db.Uuid
  printJobId        String       @unique @map("print_job_id") @db.Uuid
  /// Denormalized from the job and checked against it by a trigger. The read
  /// side scopes an Operator by this column, so a wrong value here would be a
  /// way to see another kiosk's work.
  sessionId         String       @map("session_id") @db.Uuid
  kioskId           String       @map("kiosk_id") @db.VarChar(64)
  outcome           String       @db.VarChar(32)
  /// Mandatory, operator-written, and bounded. It cannot name a document: the
  /// people who write it are never shown a filename.
  reason            String       @db.VarChar(280)
  /// Derived from the outcome and pinned by a check constraint, so the two can
  /// never disagree about whether a person thought money was owed.
  refundSuggested   Boolean      @map("refund_suggested")
  /// What the operator counted, when they could count. Null is a real answer.
  observedSheets    Int?         @map("observed_sheets")
  resolvedByAdminId String       @map("resolved_by_admin_id") @db.Uuid
  /// The role held at the time. Roles change; evidence should not need a join
  /// to a mutable row to be read years later.
  resolvedByRole    String       @map("resolved_by_role") @db.VarChar(24)
  /// Digest of the submitted outcome and reason. A repeat of the same request
  /// replays the stored answer; a different one is refused rather than ignored.
  requestDigest     String       @map("request_digest") @db.VarChar(64)
  createdAt         DateTime     @default(now()) @map("created_at")
  printJob          PrintJob     @relation(fields: [printJobId], references: [id], onDelete: Restrict)
  session           PrintSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  resolvedBy        AdminUser    @relation(fields: [resolvedByAdminId], references: [id], onDelete: Restrict)

  @@index([kioskId, createdAt])
  @@index([refundSuggested, createdAt])
  @@map("print_job_recovery_resolutions")
}

/// A later, higher-authority account of the same print.
///
/// The resolution it supersedes stays exactly as written. Somebody who could
/// edit their own account of a paid print could launder a failure into a
/// success, so a correction appends rather than overwrites, is made by a role
/// that does not record observations, and leaves both versions readable.
///
/// `supersedesId` names the record the corrector was looking at — the original
/// resolution, or the newest correction when a print has been through this
/// before. It is unique, so each record can be superseded once: two people
/// correcting the same print at the same moment collide in the database instead
/// of quietly overwriting each other.
model PrintJobRecoveryCorrection {
  id                 String       @id @db.Uuid
  printJobId         String       @map("print_job_id") @db.Uuid
  /// Denormalized from the job and pinned by a trigger, as the resolution's are.
  sessionId          String       @map("session_id") @db.Uuid
  kioskId            String       @map("kiosk_id") @db.VarChar(64)
  /// The resolution or earlier correction this one replaces. Not a foreign key
  /// because it names a row in one of two tables; a trigger checks both.
  supersedesId       String       @unique @map("supersedes_id") @db.Uuid
  outcome            String       @db.VarChar(32)
  reason             String       @db.VarChar(280)
  refundSuggested    Boolean      @map("refund_suggested")
  observedSheets     Int?         @map("observed_sheets")
  correctedByAdminId String       @map("corrected_by_admin_id") @db.Uuid
  correctedByRole    String       @map("corrected_by_role") @db.VarChar(24)
  requestDigest      String       @map("request_digest") @db.VarChar(64)
  createdAt          DateTime     @default(now()) @map("created_at")
  printJob           PrintJob     @relation(fields: [printJobId], references: [id], onDelete: Restrict)
  session            PrintSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  correctedBy        AdminUser    @relation(fields: [correctedByAdminId], references: [id], onDelete: Restrict)

  @@index([printJobId, createdAt])
  @@index([kioskId, createdAt])
  @@map("print_job_recovery_corrections")
}

/// Why a refund exists, when a person is the reason it exists.
///
/// `refunds` is the ledger the payment path also writes to, and a row there
/// means the same thing whoever raised it. This is the provenance of the ones a
/// named person raised: the print it was about, the account of that print they
/// were reading, and the words they wrote at the time.
///
/// A refund carrying the `OPERATOR_REQUESTED` reason cannot exist without a row
/// here — a deferred constraint trigger checks it at commit — so the ledger
/// cannot acquire a human-authorized obligation that nobody is recorded as
/// having authorized. The payment path's own automatic compensations
/// (`LATE_CAPTURE`, `AMOUNT_MISMATCH`, `PRINT_FAILED`) are untouched by it.
model RefundAuthorization {
  id                  String       @id @db.Uuid
  refundId            String       @unique @map("refund_id") @db.Uuid
  /// One authorized refund per print. The obligation's own
  /// `UNIQUE (payment_id, reason)` says the same thing about the payment; this
  /// says it about the thing a person was actually looking at.
  printJobId          String       @unique @map("print_job_id") @db.Uuid
  sessionId           String       @map("session_id") @db.Uuid
  /// Pinned to the refund's own by a trigger rather than by a foreign key: the
  /// refund already references the payment, so this cannot drift from it.
  paymentId           String       @map("payment_id") @db.Uuid
  amountMinor         Int          @map("amount_minor")
  currency            String       @db.Char(3)
  currencyExponent    Int          @map("currency_exponent")
  reason              String       @db.VarChar(280)
  /// The account of the print this decision was made against, copied here so
  /// the justification can still be read if the observation is later corrected.
  observedOutcome     String       @map("observed_outcome") @db.VarChar(32)
  observedRecordId    String       @map("observed_record_id") @db.Uuid
  authorizedByAdminId String       @map("authorized_by_admin_id") @db.Uuid
  authorizedByRole    String       @map("authorized_by_role") @db.VarChar(24)
  requestDigest       String       @map("request_digest") @db.VarChar(64)
  createdAt           DateTime     @default(now()) @map("created_at")
  refund              Refund       @relation(fields: [refundId], references: [id], onDelete: Restrict)
  printJob            PrintJob     @relation(fields: [printJobId], references: [id], onDelete: Restrict)
  session             PrintSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  authorizedBy        AdminUser    @relation(fields: [authorizedByAdminId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("refund_authorizations")
}

/// A person asking retention to try a dead-lettered cleanup run again.
///
/// A request, not an edit. The control plane holds no privilege on
/// `cleanup_runs`: it appends one of these, and the worker that owns retention
/// re-arms its own run. That is what stops "retry the cleanup" from being a way
/// to reach into retention state and change something else.
///
/// Unique per dead-lettering rather than per run. A request answers one
/// specific failure, so re-arming consumes it by making the run's status no
/// longer `DEAD_LETTER`; if the run fails its way back to dead-lettered, that
/// is a new `deadLetteredAt` and needs a new decision from a person.
model CleanupRetryRequest {
  id                 String     @id @db.Uuid
  cleanupRunId       String     @map("cleanup_run_id") @db.Uuid
  sessionId          String     @map("session_id") @db.Uuid
  /// The dead-lettering this request was made about, copied from the run and
  /// pinned by a trigger. It is half the idempotency key.
  deadLetteredAt     DateTime   @map("dead_lettered_at")
  /// What the run had already tried, and why it gave up. Evidence about the
  /// decision, kept because the run's own columns move on when it retries.
  attempts           Int
  lastErrorCode      String?    @map("last_error_code") @db.VarChar(80)
  reason             String     @db.VarChar(280)
  requestedByAdminId String     @map("requested_by_admin_id") @db.Uuid
  requestedByRole    String     @map("requested_by_role") @db.VarChar(24)
  createdAt          DateTime   @default(now()) @map("created_at")
  cleanupRun         CleanupRun @relation(fields: [cleanupRunId], references: [id], onDelete: Cascade)
  requestedBy        AdminUser  @relation(fields: [requestedByAdminId], references: [id], onDelete: Restrict)

  @@unique([cleanupRunId, deadLetteredAt])
  @@index([createdAt])
  @@map("cleanup_retry_requests")
}

/// The operation ledger. Append-only: what the device said is evidence, and a
/// retry writes the next entry rather than rewriting the previous one.
model PrintJobEvent {
  id          String   @id @db.Uuid
  printJobId  String   @map("print_job_id") @db.Uuid
  sequence    Int
  type        String   @db.VarChar(32)
  operationId String?  @map("operation_id") @db.Uuid
  status      String   @db.VarChar(24)
  confidence  String?  @db.VarChar(16)
  failureCode String?  @map("failure_code") @db.VarChar(48)
  warningCode String?  @map("warning_code") @db.VarChar(32)
  detail      Json?
  /// What the device reported seeing. Separate from `detail` because that is
  /// free-form and ungranted: this holds only the bounded operational shape the
  /// agent contract validates, so the control plane can read it.
  deviceDetail Json?   @map("device_detail")
  createdAt   DateTime @default(now()) @map("created_at")
  printJob    PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)

  @@unique([printJobId, sequence])
  @@index([printJobId, createdAt])
  @@map("print_job_events")
}

/// Durable work for a kiosk agent. The kiosk opens no inbound port: it leases
/// a command over its own outbound connection and reports the result back.
/// The operation identifier is stable across redeliveries, so a device that
/// already saw it can recognise it rather than printing twice.
model AgentCommand {
  id              String        @id @db.Uuid
  kioskId         String        @map("kiosk_id") @db.VarChar(64)
  sessionId       String?       @map("session_id") @db.Uuid
  printJobId      String?       @map("print_job_id") @db.Uuid
  operationId     String        @unique @map("operation_id") @db.Uuid
  type            String        @db.VarChar(32)
  status          String        @db.VarChar(24)
  payload         Json
  attempts        Int           @default(0)
  availableAt     DateTime      @default(now()) @map("available_at")
  claimToken      String?       @unique @map("claim_token") @db.Uuid
  claimedAt       DateTime?     @map("claimed_at")
  leaseExpiresAt  DateTime?     @map("lease_expires_at")
  expiresAt       DateTime      @map("expires_at")
  resultCode      String?       @map("result_code") @db.VarChar(48)
  completedAt     DateTime?     @map("completed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")
  kiosk           Kiosk         @relation(fields: [kioskId], references: [id], onDelete: Cascade)
  session         PrintSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  printJob        PrintJob?     @relation(fields: [printJobId], references: [id], onDelete: Cascade)

  @@unique([printJobId], map: "agent_commands_one_per_print_job_idx")
  @@index([kioskId, status, availableAt])
  @@index([status, leaseExpiresAt])
  @@map("agent_commands")
}

model SessionUploadGrant {
  id              String        @id @db.Uuid
  sessionId       String        @map("session_id") @db.Uuid
  tokenDigest     String        @unique @map("token_digest") @db.VarChar(64)
  shortCodeDigest String        @map("short_code_digest") @db.VarChar(64)
  status          String        @default("ACTIVE") @db.VarChar(24)
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  claimedClientId String?       @map("claimed_client_id") @db.Uuid
  claimedAt       DateTime?     @map("claimed_at")
  revokedAt       DateTime?     @map("revoked_at")
  session         PrintSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  claimedClient   MobileClient? @relation("ClaimedUploadGrant", fields: [claimedClientId, sessionId], references: [id, sessionId], onDelete: Restrict)

  @@unique([claimedClientId, sessionId])
  @@index([sessionId, status])
  @@map("session_upload_grants")
}

model MobileClient {
  id                String              @id @db.Uuid
  sessionId         String              @map("session_id") @db.Uuid
  cookieDigest      String              @unique @map("cookie_digest") @db.VarChar(64)
  clientNonceDigest String              @map("client_nonce_digest") @db.VarChar(64)
  status            String              @default("ACTIVE") @db.VarChar(24)
  expiresAt         DateTime            @map("expires_at")
  lastSeenAt        DateTime?           @map("last_seen_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  revokedAt         DateTime?           @map("revoked_at")
  session           PrintSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  claimedGrant      SessionUploadGrant? @relation("ClaimedUploadGrant")
  uploadedFiles     UploadedFile[]

  @@unique([id, sessionId])
  @@unique([sessionId, clientNonceDigest])
  @@index([sessionId, status])
  @@index([status, expiresAt])
  @@map("mobile_clients")
}

model UploadedFile {
  id                       String           @id @db.Uuid
  sessionId                String           @map("session_id") @db.Uuid
  uploadedByClientId       String           @map("uploaded_by_client_id") @db.Uuid
  clientFileId             String           @map("client_file_id") @db.Uuid
  ordinal                  Int
  displayName              String           @map("display_name") @db.VarChar(160)
  status                   String           @db.VarChar(24)
  kind                     String?          @db.VarChar(12)
  declaredMime             String?          @map("declared_mime") @db.VarChar(100)
  detectedMime             String?          @map("detected_mime") @db.VarChar(100)
  extension                String?          @db.VarChar(10)
  reservedBytes            Int              @map("reserved_bytes")
  sizeBytes                Int?             @map("size_bytes")
  contentSha256            String?          @map("content_sha256") @db.VarChar(64)
  quarantineObjectKey      String?          @unique @map("quarantine_object_key") @db.VarChar(512)
  rejectionCode            String?          @map("rejection_code") @db.VarChar(80)
  processingRevision       Int              @default(1) @map("processing_revision")
  processingGeneration     Int              @default(0) @map("processing_generation")
  processingAttempts       Int              @default(0) @map("processing_attempts")
  processingAvailableAt    DateTime         @default(now()) @map("processing_available_at")
  processingEnqueuedAt     DateTime?        @map("processing_enqueued_at")
  processingClaimToken     String?          @unique @map("processing_claim_token") @db.Uuid
  processingLeaseExpiresAt DateTime?        @map("processing_lease_expires_at")
  processingStartedAt      DateTime?        @map("processing_started_at")
  processingErrorCode      String?          @map("processing_error_code") @db.VarChar(80)
  malwareScanStatus        String           @default("PENDING") @map("malware_scan_status") @db.VarChar(24)
  pageCount                Int?             @map("page_count")
  cleanupAttempts          Int              @default(0) @map("cleanup_attempts")
  cleanupDueAt             DateTime?        @map("cleanup_due_at")
  cleanupErrorCode         String?          @map("cleanup_error_code") @db.VarChar(80)
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at")
  quarantinedAt            DateTime?        @map("quarantined_at")
  readyAt                  DateTime?        @map("ready_at")
  deleteRequestedAt        DateTime?        @map("delete_requested_at")
  deletedAt                DateTime?        @map("deleted_at")
  session                  PrintSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  uploadedByClient         MobileClient     @relation(fields: [uploadedByClientId, sessionId], references: [id, sessionId], onDelete: Restrict)
  pages                    FilePage[]
  derivatives              FileDerivative[]

  @@unique([sessionId, clientFileId])
  @@unique([sessionId, ordinal])
  @@index([sessionId, status, ordinal])
  @@index([status, updatedAt])
  @@index([status, processingAvailableAt, createdAt])
  @@index([status, processingLeaseExpiresAt])
  @@index([cleanupDueAt])
  @@map("uploaded_files")
}

model FilePage {
  id                  String         @id @db.Uuid
  fileId              String         @map("file_id") @db.Uuid
  processingRevision  Int            @map("processing_revision")
  pageNumber          Int            @map("page_number")
  widthPixels         Int            @map("width_pixels")
  heightPixels        Int            @map("height_pixels")
  previewDerivativeId String         @map("preview_derivative_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at")
  file                UploadedFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)
  previewDerivative   FileDerivative @relation("FilePagePreview", fields: [previewDerivativeId, fileId, processingRevision, pageNumber], references: [id, fileId, processingRevision, pageNumber], onDelete: Restrict)

  @@unique([fileId, processingRevision, pageNumber])
  @@unique([previewDerivativeId, fileId, processingRevision, pageNumber])
  @@index([fileId, processingRevision])
  @@map("file_pages")
}

model FileDerivative {
  id                 String       @id @db.Uuid
  fileId             String       @map("file_id") @db.Uuid
  processingRevision Int          @map("processing_revision")
  type               String       @db.VarChar(32)
  status             String       @db.VarChar(24)
  pageNumber         Int          @default(0) @map("page_number")
  objectKey          String       @unique @map("object_key") @db.VarChar(512)
  mimeType           String       @map("mime_type") @db.VarChar(100)
  sizeBytes          Int          @map("size_bytes")
  sha256             String       @db.VarChar(64)
  widthPixels        Int?         @map("width_pixels")
  heightPixels       Int?         @map("height_pixels")
  createdAt          DateTime     @default(now()) @map("created_at")
  deletedAt          DateTime?    @map("deleted_at")
  file               UploadedFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  previewForPage     FilePage?    @relation("FilePagePreview")

  @@unique([id, fileId, processingRevision, pageNumber])
  @@unique([fileId, type, processingRevision, pageNumber])
  @@index([fileId, processingRevision, status])
  @@index([status, createdAt])
  @@map("file_derivatives")
}

/// The record of who did what. Append-only and enforced as such by a trigger:
/// an actor who could rewrite this table could erase the evidence of every
/// other thing they did, so no application path and no administrator may
/// update or delete a row.
///
/// The kiosk and session identifiers are recorded values, not foreign keys. An
/// audit row keeps naming the session it was about after that session is gone,
/// which is what a historical record is for — and it means an operational
/// deletion is never blocked by, or able to rewrite, the log that describes it.
model AuditEvent {
  id         String   @id @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at")
  actorType  String   @map("actor_type") @db.VarChar(32)
  actorId    String   @map("actor_id") @db.VarChar(100)
  kioskId    String?  @map("kiosk_id") @db.VarChar(64)
  sessionId  String?  @map("session_id") @db.Uuid
  action     String   @db.VarChar(100)
  outcome    String   @db.VarChar(32)
  requestId  String?  @map("request_id") @db.VarChar(100)
  metadata   Json?

  @@index([sessionId, occurredAt])
  @@index([actorType, actorId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_events")
}

/// A person who may use the control plane.
///
/// The username identifies; the password (its Argon2id digest lives in
/// `admin_passwords`) is the base factor for everybody; WebAuthn is layered on
/// top for privileged roles. The display name is for an operator to recognise a
/// colleague; nothing in this row identifies a customer.
///
/// An account holds exactly one role. Multiple roles would raise a question
/// about how their capabilities combine, and the answer would eventually be
/// "the union", which is how a superuser appears by accident.
model AdminUser {
  id           String   @id @db.Uuid
  /// The WebAuthn user handle. Random, opaque and stable: never an email
  /// address, so a stolen authenticator database reveals no identities.
  userHandle   Bytes    @unique @map("user_handle")
  /// The sign-in name. Lowercase, short, safe to say over a phone.
  username     String   @unique @db.VarChar(32)
  displayName  String   @map("display_name") @db.VarChar(120)
  role         String   @db.VarChar(24)
  status       String   @default("PROVISIONING") @db.VarChar(24)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  activatedAt  DateTime? @map("activated_at")
  suspendedAt  DateTime? @map("suspended_at")
  disabledAt   DateTime? @map("disabled_at")
  lastLoginAt  DateTime? @map("last_login_at")

  authenticators AdminAuthenticator[]
  sessions       AdminSession[]
  kioskScopes    AdminKioskScope[]
  challenges     AdminWebAuthnChallenge[]
  breakGlass     AdminBreakGlassCredential[]
  password       AdminPassword?
  invitations    AdminInvitation[] @relation("AdminInvitationTarget")
  issuedInvitations AdminInvitation[] @relation("AdminInvitationIssuer")
  passwordResets AdminPasswordReset[] @relation("AdminPasswordResetTarget")
  issuedPasswordResets AdminPasswordReset[] @relation("AdminPasswordResetIssuer")
  recoveryResolutions PrintJobRecoveryResolution[]
  recoveryCorrections PrintJobRecoveryCorrection[]
  refundAuthorizations RefundAuthorization[]
  cleanupRetryRequests CleanupRetryRequest[]
  changeExecutions     AdminChangeExecution[]

  @@index([status, role])
  @@map("admin_users")
}

/// The knowledge factor, one row per account.
///
/// The digest is a self-describing PHC string — `$argon2id$v=19$m=...` — so the
/// parameters travel with the hash and can be strengthened later without
/// re-hashing anything until the person next signs in. The password itself is
/// unrecoverable from here by construction; there is nothing else in the row.
///
/// Kept out of `admin_users` deliberately: the people-writer role holds
/// column-level UPDATE on that table, and a password digest must never be a
/// column an account-management connection can reach.
model AdminPassword {
  adminUserId String   @id @map("admin_user_id") @db.Uuid
  digest      String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@map("admin_passwords")
}

/// One invitation: the only way an account comes to exist from the panel, and
/// the way the CLI hands over a bootstrap account.
///
/// The account row is created with the invitation, already carrying its role,
/// so acceptance decides nothing — it only proves the code and supplies the
/// factors. Only a digest of the code is stored. Unlike break-glass, the
/// invitation is consumed when the account activates rather than when the
/// first ceremony begins: a fumbled key enrolment costs a retry, not a
/// reissue.
model AdminInvitation {
  id              String    @id @db.Uuid
  adminUserId     String    @map("admin_user_id") @db.Uuid
  /// Who authorised it. Null when it came from the CLI bootstrap.
  issuedByAdminId String?   @map("issued_by_admin_id") @db.Uuid
  secretDigest    String    @unique @map("secret_digest") @db.VarChar(64)
  reason          String    @db.VarChar(280)
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  /// Set when the invited account activates.
  consumedAt      DateTime? @map("consumed_at")
  revokedAt       DateTime? @map("revoked_at")

  adminUser AdminUser  @relation("AdminInvitationTarget", fields: [adminUserId], references: [id], onDelete: Restrict)
  issuedBy  AdminUser? @relation("AdminInvitationIssuer", fields: [issuedByAdminId], references: [id], onDelete: Restrict)

  @@index([adminUserId, consumedAt])
  @@index([expiresAt])
  @@map("admin_invitations")
}

/// One administrator-assisted password reset.
///
/// The issuer never sees or chooses the password that results; they carry a
/// short-lived single-use code to the person, and completing it revokes every
/// session the account had. Only a digest of the code is stored. Another
/// delivery mechanism later (Telegram, email) changes who carries the code,
/// not this table.
model AdminPasswordReset {
  id              String    @id @db.Uuid
  adminUserId     String    @map("admin_user_id") @db.Uuid
  /// Who authorised it. Null when it came from the CLI.
  issuedByAdminId String?   @map("issued_by_admin_id") @db.Uuid
  secretDigest    String    @unique @map("secret_digest") @db.VarChar(64)
  reason          String    @db.VarChar(280)
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  revokedAt       DateTime? @map("revoked_at")

  adminUser AdminUser  @relation("AdminPasswordResetTarget", fields: [adminUserId], references: [id], onDelete: Restrict)
  issuedBy  AdminUser? @relation("AdminPasswordResetIssuer", fields: [issuedByAdminId], references: [id], onDelete: Restrict)

  @@index([adminUserId, consumedAt])
  @@index([expiresAt])
  @@map("admin_password_resets")
}

/// One enrolled FIDO2 credential.
///
/// Several per account, by requirement: a privileged account below its minimum
/// cannot be activated, and a revocation that would take it below the minimum
/// is refused. Both rules are enforced here in the database as well as in the
/// application, because the failure mode is an operator locked out of the
/// control plane during the incident they needed it for.
model AdminAuthenticator {
  id             String    @id @db.Uuid
  adminUserId    String    @map("admin_user_id") @db.Uuid
  /// base64url, as returned by the authenticator.
  credentialId   String    @unique @map("credential_id") @db.VarChar(400)
  publicKey      Bytes     @map("public_key")
  /// Replay defence. An authenticator that reports a counter must never report
  /// one lower than we already saw.
  signCount      Int       @default(0) @map("sign_count")
  transports     String[]
  /// "platform" | "cross-platform" | null when the authenticator declined.
  attachment     String?   @db.VarChar(24)
  /// True when the credential may leave the device it was created on. A
  /// Technical Admin credential may not.
  backupEligible Boolean   @default(false) @map("backup_eligible")
  backedUp       Boolean   @default(false) @map("backed_up")
  aaguid         String?   @db.VarChar(36)
  /// Chosen by the operator so they can tell two keys apart when revoking one.
  label          String    @db.VarChar(80)
  createdAt      DateTime  @default(now()) @map("created_at")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  revokedReason  String?   @map("revoked_reason") @db.VarChar(48)
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, revokedAt])
  @@map("admin_authenticators")
}

/// A revocable server-side admin session.
///
/// The cookie carries a random token; only its digest is stored, so reading
/// this table yields nothing that can be replayed. Revocation is immediate
/// because every request re-reads this row — there is no stateless token that
/// stays valid until it expires.
model AdminSession {
  id            String    @id @db.Uuid
  adminUserId   String    @map("admin_user_id") @db.Uuid
  tokenDigest   String    @unique @map("token_digest") @db.VarChar(64)
  /// Bound to this session, so a token lifted from another session's cookie
  /// cannot satisfy the double-submit check here.
  csrfDigest    String    @map("csrf_digest") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at")
  /// Rolls forward while the session is used. Passing it locks the session —
  /// a reauthentication reopens it — and only the absolute limit ends it.
  idleExpiresAt DateTime  @map("idle_expires_at")
  /// Never extends.
  hardExpiresAt DateTime  @map("hard_expires_at")
  lastSeenAt    DateTime? @map("last_seen_at")
  /// When this session last completed a strong reauthentication — a WebAuthn
  /// assertion, or the password for roles that hold nothing stronger. R2
  /// actions require this to be recent; a stolen cookie alone can never
  /// satisfy it.
  lastStepUpAt  DateTime? @map("last_step_up_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason") @db.VarChar(48)
  /// Where the session was created and last seen from, and what it called
  /// itself. Informational context for the person reviewing their own
  /// sessions; never treated as proof of device identity.
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(280)
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, revokedAt])
  @@index([hardExpiresAt])
  @@map("admin_sessions")
}

/// One in-flight WebAuthn ceremony.
///
/// Single-use and short-lived. The challenge is a public nonce — it is sent to
/// the browser in the clear — so it is stored as issued; what makes the
/// ceremony safe is the signature, not the secrecy of the challenge.
model AdminWebAuthnChallenge {
  id          String     @id @db.Uuid
  /// REGISTRATION | AUTHENTICATION | STEP_UP | UNLOCK |
  /// BREAK_GLASS_REGISTRATION | INVITATION_REGISTRATION
  purpose     String     @db.VarChar(32)
  challenge   String     @db.VarChar(400)
  /// Null for a discoverable-credential login, where the account is not known
  /// until the authenticator answers.
  adminUserId String?    @map("admin_user_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("admin_webauthn_challenges")
}

/// The sealed offline path back in when every authenticator for an account is
/// gone.
///
/// Only its digest is stored, so the database holds nothing usable. It can do
/// exactly one thing: authorise the enrolment of a new authenticator on the one
/// account it names. It never creates a session, never carries a capability and
/// can never perform an operational action. Consuming it is a single-use event
/// that raises an alert.
model AdminBreakGlassCredential {
  id            String    @id @db.Uuid
  adminUserId   String    @map("admin_user_id") @db.Uuid
  label         String    @db.VarChar(80)
  secretDigest  String    @unique @map("secret_digest") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  revokedAt     DateTime? @map("revoked_at")
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, consumedAt])
  @@map("admin_break_glass_credentials")
}

/// Which kiosks an Operator may act on.
///
/// A contextual restriction rather than a capability: the Operator holds
/// `print.recovery.resolve` everywhere or nowhere, but the query that finds the
/// job is bounded by these rows. An account with no scope rows can act on no
/// kiosk, which is the safe default for a newly created Operator.
///
/// Taking a kiosk away sets `revokedAt` rather than removing the row, so who
/// could act where at a given moment stays answerable. Re-assigning the same
/// kiosk clears it again on the row that is already there — the primary key
/// keeps one row per pair, so there is never a second row disagreeing about
/// whether the assignment is live.
model AdminKioskScope {
  adminUserId String    @map("admin_user_id") @db.Uuid
  kioskId     String    @map("kiosk_id") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  kiosk       Kiosk     @relation(fields: [kioskId], references: [id], onDelete: Cascade)

  @@id([adminUserId, kioskId])
  @@index([kioskId])
  @@index([adminUserId, revokedAt])
  @@map("admin_kiosk_scopes")
}

/// One published tariff, and who published it.
///
/// Append-only, and written in the same transaction as the tariff it names. There
/// is no proposal and no pending state: a row here is a change that happened.
/// A deferred constraint trigger refuses, at COMMIT, any tariff the control plane
/// wrote that no row here accounts for byte for byte.
model AdminChangeExecution {
  id                 String   @id @db.Uuid
  kind               String   @db.VarChar(40)
  /// The change verbatim, so the row reads without reconstruction. The digest
  /// beside it is what anything actually depends on.
  payload            Json
  payloadDigest      String   @map("payload_digest") @db.VarChar(64)
  /// The tariff this replaced, so the sequence of publications is a checkable
  /// chain rather than rows that happen to be in order.
  baselineDigest     String   @map("baseline_digest") @db.VarChar(64)
  reason             String   @db.VarChar(280)
  publishedByAdminId String   @map("published_by_admin_id") @db.Uuid
  publishedByRole    String   @map("published_by_role") @db.VarChar(24)
  resultRuleSetId    String?  @unique @map("result_rule_set_id") @db.Uuid
  resultRef          String?  @map("result_ref") @db.VarChar(64)
  replacedRef        String?  @map("replaced_ref") @db.VarChar(64)
  createdAt          DateTime @default(now()) @map("created_at")

  publishedBy   AdminUser       @relation(fields: [publishedByAdminId], references: [id], onDelete: Restrict)
  resultRuleSet PricingRuleSet? @relation(fields: [resultRuleSetId], references: [id], onDelete: Restrict)

  @@index([kind, createdAt])
  @@index([publishedByAdminId])
  @@map("admin_change_executions")
}

model OutboxEvent {
  id              String       @id @db.Uuid
  aggregateType   String       @map("aggregate_type") @db.VarChar(50)
  aggregateId     String       @map("aggregate_id") @db.Uuid
  sequence        Int
  type            String       @db.VarChar(100)
  payload         Json
  status          String       @default("PENDING") @db.VarChar(24)
  publishAttempts Int          @default(0) @map("publish_attempts")
  availableAt     DateTime     @default(now()) @map("available_at")
  lockedAt        DateTime?    @map("locked_at")
  claimToken      String?      @map("claim_token") @db.Uuid
  lastErrorCode   String?      @map("last_error_code") @db.VarChar(80)
  createdAt       DateTime     @default(now()) @map("created_at")
  publishedAt     DateTime?    @map("published_at")
  session         PrintSession @relation(fields: [aggregateId], references: [id], onDelete: Cascade)

  @@unique([aggregateId, sequence])
  @@index([status, availableAt, createdAt])
  @@map("outbox_events")
}

model SessionEvent {
  id         String       @id @db.Uuid
  sessionId  String       @map("session_id") @db.Uuid
  kioskId    String       @map("kiosk_id") @db.VarChar(64)
  sequence   Int
  type       String       @db.VarChar(100)
  payload    Json
  occurredAt DateTime     @map("occurred_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  session    PrintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kiosk      Kiosk        @relation(fields: [kioskId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([kioskId, occurredAt])
  @@index([sessionId, sequence])
  @@map("session_events")
}

model IdempotencyRecord {
  id             String   @id @db.Uuid
  actorId        String   @map("actor_id") @db.VarChar(100)
  action         String   @db.VarChar(100)
  keyDigest      String   @map("key_digest") @db.VarChar(64)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  resourceId     String?  @map("resource_id") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([actorId, action, keyDigest])
  @@index([expiresAt])
  @@map("idempotency_records")
}
