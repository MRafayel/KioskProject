generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model SystemMetadata {
  key       String   @id @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_metadata")
}

model Kiosk {
  id                  String            @id @db.VarChar(64)
  publicCode          String            @unique @map("public_code") @db.VarChar(64)
  name                String            @db.VarChar(160)
  status              String            @default("ACTIVE") @db.VarChar(32)
  timezone            String            @default("Asia/Yerevan") @db.VarChar(64)
  capabilities        Json
  capabilitiesVersion Int               @default(1) @map("capabilities_version")
  configVersion       Int               @default(1) @map("config_version")
  lastSeenAt          DateTime?         @map("last_seen_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  credentials         KioskCredential[]
  sessions            PrintSession[]
  sessionEvents       SessionEvent[]
  printJobs           PrintJob[]
  agentCommands       AgentCommand[]
  adminScopes         AdminKioskScope[]

  @@index([status])
  @@index([lastSeenAt])
  @@map("kiosks")
}

model KioskCredential {
  id           String    @id @db.Uuid
  kioskId      String    @map("kiosk_id") @db.VarChar(64)
  credentialId String    @unique @map("credential_id") @db.VarChar(100)
  secretDigest String    @unique @map("secret_digest") @db.VarChar(64)
  scopes       String[]
  issuedAt     DateTime  @default(now()) @map("issued_at")
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  kiosk        Kiosk     @relation(fields: [kioskId], references: [id], onDelete: Cascade)

  @@index([kioskId, revokedAt])
  @@map("kiosk_credentials")
}

model PrintSession {
  id                      String                 @id @db.Uuid
  publicId                String                 @unique @map("public_id") @db.VarChar(80)
  kioskId                 String                 @map("kiosk_id") @db.VarChar(64)
  locale                  String                 @db.VarChar(10)
  state                   String                 @db.VarChar(40)
  stateVersion            Int                    @default(1) @map("state_version")
  eventSequence           Int                    @default(1) @map("event_sequence")
  currentSettingsRevision Int?                   @map("current_settings_revision")
  activeQuoteId           String?                @unique @map("active_quote_id") @db.Uuid
  idleExpiresAt           DateTime               @map("idle_expires_at")
  hardExpiresAt           DateTime               @map("hard_expires_at")
  terminalReason          String?                @map("terminal_reason") @db.VarChar(80)
  /// Mirrors the cleanup run so operators can find overdue retention from one
  /// row. NOT_DUE until the session ends.
  cleanupStatus           String                 @default("NOT_DUE") @map("cleanup_status") @db.VarChar(24)
  cleanupDueAt            DateTime?              @map("cleanup_due_at")
  /// The tombstone. Set only by a cleanup run that proved nothing is left, and
  /// enforced by a trigger that consults the artifact ledger.
  filesDeletedAt          DateTime?              @map("files_deleted_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @default(now()) @updatedAt @map("updated_at")
  canceledAt              DateTime?              @map("canceled_at")
  expiredAt               DateTime?              @map("expired_at")
  completedAt             DateTime?              @map("completed_at")
  kiosk                   Kiosk                  @relation(fields: [kioskId], references: [id], onDelete: Restrict)
  activeQuote             PriceQuote?            @relation("SessionActiveQuote", fields: [activeQuoteId], references: [id], onDelete: SetNull)
  uploadGrants            SessionUploadGrant[]
  mobileClients           MobileClient[]
  uploadedFiles           UploadedFile[]
  settingRevisions        PrintSettingRevision[]
  priceQuotes             PriceQuote[]           @relation("SessionQuotes")
  payments                Payment[]
  refunds                 Refund[]
  printJobs               PrintJob[]
  agentCommands           AgentCommand[]
  outboxEvents            OutboxEvent[]
  sessionEvents           SessionEvent[]
  cleanupRun              CleanupRun?
  recoveryResolutions     PrintJobRecoveryResolution[]

  @@index([kioskId, createdAt])
  @@index([state, idleExpiresAt])
  @@index([state, hardExpiresAt])
  @@index([cleanupStatus, cleanupDueAt])
  @@map("print_sessions")
}

/// One session's document deletion, as a resumable workflow rather than a row
/// update. It records the last checkpoint that succeeded, so an interrupted
/// run repeats from there instead of starting over, and a lease keeps two
/// workers from deleting the same objects at once. A run is never quietly
/// abandoned: when its attempts are spent it is dead-lettered for a person,
/// because the documents are still there.
model CleanupRun {
  id                      String       @id @db.Uuid
  sessionId               String       @unique @map("session_id") @db.Uuid
  reason                  String       @db.VarChar(40)
  status                  String       @default("PENDING") @db.VarChar(24)
  checkpoint              String       @default("SCHEDULED") @db.VarChar(32)
  attempts                Int          @default(0)
  availableAt             DateTime     @default(now()) @map("available_at")
  leaseToken              String?      @unique @map("lease_token") @db.Uuid
  leaseExpiresAt          DateTime?    @map("lease_expires_at")
  lastErrorCode           String?      @map("last_error_code") @db.VarChar(80)
  objectsDeleted          Int          @default(0) @map("objects_deleted")
  orphanObjectsDeleted    Int          @default(0) @map("orphan_objects_deleted")
  multipartUploadsAborted Int          @default(0) @map("multipart_uploads_aborted")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at")
  startedAt               DateTime?    @map("started_at")
  completedAt             DateTime?    @map("completed_at")
  deadLetteredAt          DateTime?    @map("dead_lettered_at")
  session                 PrintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@map("cleanup_runs")
}

/// Immutable pricing snapshot. A quote, payment and print job refer to one
/// exact revision; the sole later amendment is the database-guarded removal of
/// per-document content digests after the session becomes terminal.
model PrintSettingRevision {
  id                 String       @id @db.Uuid
  sessionId          String       @map("session_id") @db.Uuid
  revision           Int
  copies             Int
  duplex             String       @db.VarChar(16)
  paperSize          String       @map("paper_size") @db.VarChar(16)
  orientation        String       @db.VarChar(16)
  scaling            String       @db.VarChar(16)
  collate            Boolean
  colorMode          String       @map("color_mode") @db.VarChar(16)
  selections         Json
  /// Set once by retention when raw per-document content digests are removed
  /// from selections. All priced paper/range aggregates remain immutable.
  selectionsRedactedAt DateTime?  @map("selections_redacted_at")
  selectedPages      Int          @map("selected_pages")
  printedSides       Int          @map("printed_sides")
  physicalSheets     Int          @map("physical_sheets")
  capabilityVersion  Int          @map("capability_version")
  manifestHash       String       @map("manifest_hash") @db.VarChar(64)
  createdByActorType String       @map("created_by_actor_type") @db.VarChar(32)
  createdByActorId   String       @map("created_by_actor_id") @db.VarChar(100)
  createdAt          DateTime     @default(now()) @map("created_at")
  session            PrintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  quotes             PriceQuote[]
  printJobs          PrintJob[]

  @@unique([sessionId, revision])
  @@index([sessionId, createdAt])
  @@map("print_setting_revisions")
}

/// A published rule set is immutable. Corrections create another version.
model PricingRuleSet {
  id                 String        @id @db.Uuid
  version            String        @unique @db.VarChar(40)
  scope              String        @db.VarChar(24)
  scopeRef           String        @default("") @map("scope_ref") @db.VarChar(64)
  currency           String        @db.Char(3)
  currencyExponent   Int           @map("currency_exponent")
  status             String        @db.VarChar(16)
  rounding           String        @db.VarChar(16)
  taxMode            String        @map("tax_mode") @db.VarChar(16)
  minimumApplication String        @map("minimum_application") @db.VarChar(16)
  validFrom          DateTime      @map("valid_from")
  validUntil         DateTime?     @map("valid_until")
  publishedAt        DateTime?     @map("published_at")
  archivedAt         DateTime?     @map("archived_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at")
  rules              PricingRule[]
  quotes             PriceQuote[]

  @@index([status, validFrom])
  @@map("pricing_rule_sets")
}

model PricingRule {
  id                          String         @id @db.Uuid
  ruleSetId                   String         @map("rule_set_id") @db.Uuid
  service                     String         @db.VarChar(24)
  paperSize                   String         @map("paper_size") @db.VarChar(16)
  colorMode                   String         @map("color_mode") @db.VarChar(16)
  unitAmountMinor             Int            @map("unit_amount_minor")
  duplexAdjustmentBasisPoints Int            @map("duplex_adjustment_basis_points")
  serviceFeeMinor             Int            @map("service_fee_minor")
  minimumAmountMinor          Int            @map("minimum_amount_minor")
  taxBasisPoints              Int            @map("tax_basis_points")
  priority                    Int            @default(0)
  createdAt                   DateTime       @default(now()) @map("created_at")
  ruleSet                     PricingRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([ruleSetId, service, paperSize, colorMode])
  @@map("pricing_rules")
}

model PriceQuote {
  id                     String               @id @db.Uuid
  sessionId              String               @map("session_id") @db.Uuid
  settingsRevision       Int                  @map("settings_revision")
  manifestHash           String               @map("manifest_hash") @db.VarChar(64)
  ruleSetId              String               @map("rule_set_id") @db.Uuid
  pricingVersion         String               @map("pricing_version") @db.VarChar(40)
  status                 String               @db.VarChar(16)
  currency               String               @db.Char(3)
  currencyExponent       Int                  @map("currency_exponent")
  selectedPages          Int                  @map("selected_pages")
  printedSides           Int                  @map("printed_sides")
  physicalSheets         Int                  @map("physical_sheets")
  printAmountMinor       Int                  @map("print_amount_minor")
  duplexAdjustmentMinor  Int                  @map("duplex_adjustment_minor")
  serviceFeeMinor        Int                  @map("service_fee_minor")
  minimumAdjustmentMinor Int                  @map("minimum_adjustment_minor")
  subtotalMinor          Int                  @map("subtotal_minor")
  taxMinor               Int                  @map("tax_minor")
  totalMinor             Int                  @map("total_minor")
  expiresAt              DateTime             @map("expires_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  invalidatedAt          DateTime?            @map("invalidated_at")
  invalidationReason     String?              @map("invalidation_reason") @db.VarChar(32)
  session                PrintSession         @relation("SessionQuotes", fields: [sessionId], references: [id], onDelete: Cascade)
  settings               PrintSettingRevision @relation(fields: [sessionId, settingsRevision], references: [sessionId, revision], onDelete: Cascade)
  ruleSet                PricingRuleSet       @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  activeForSession       PrintSession?        @relation("SessionActiveQuote")
  payments               Payment[]
  printJobs              PrintJob[]

  @@unique([id, sessionId])
  @@index([sessionId, createdAt])
  @@index([status, expiresAt])
  @@map("price_quotes")
}

/// The accounting record for one attempt to collect one quote's total.
/// Amount and currency are re-checked against the quote by a trigger, so a
/// payment can never be stored for a price the control plane did not issue.
model Payment {
  id                 String                @id @db.Uuid
  sessionId          String                @map("session_id") @db.Uuid
  quoteId            String                @map("quote_id") @db.Uuid
  provider           String                @db.VarChar(24)
  providerIntentId   String                @map("provider_intent_id") @db.VarChar(120)
  status             String                @db.VarChar(24)
  /// True only when this capture moved the session to PAID. A late capture is
  /// still CAPTURED in the accounting ledger, but remains false because it is
  /// owed back rather than fulfilled.
  appliedToSession   Boolean               @default(false) @map("applied_to_session")
  amountMinor        Int                   @map("amount_minor")
  currency           String                @db.Char(3)
  currencyExponent   Int                   @map("currency_exponent")
  settingsRevision   Int                   @map("settings_revision")
  manifestHash       String                @map("manifest_hash") @db.VarChar(64)
  failureCode        String?               @map("failure_code") @db.VarChar(48)
  createdByActorType String                @map("created_by_actor_type") @db.VarChar(32)
  createdByActorId   String                @map("created_by_actor_id") @db.VarChar(100)
  expiresAt          DateTime              @map("expires_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at")
  authorizedAt       DateTime?             @map("authorized_at")
  capturedAt         DateTime?             @map("captured_at")
  failedAt           DateTime?             @map("failed_at")
  session            PrintSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  quote              PriceQuote            @relation(fields: [quoteId, sessionId], references: [id, sessionId], onDelete: Restrict)
  attempts           PaymentAttempt[]
  webhookEvents      PaymentWebhookInbox[]
  refunds            Refund[]
  printJobs          PrintJob[]

  @@unique([id, sessionId])
  @@unique([provider, providerIntentId])
  @@index([sessionId, createdAt])
  @@index([status, expiresAt])
  @@map("payments")
}

/// One row per provider interaction. Append-only: a retry writes the next
/// attempt rather than rewriting the previous one.
model PaymentAttempt {
  id                   String   @id @db.Uuid
  paymentId            String   @map("payment_id") @db.Uuid
  attempt              Int
  action               String   @db.VarChar(24)
  status               String   @db.VarChar(24)
  providerReference    String?  @map("provider_reference") @db.VarChar(120)
  failureCode          String?  @map("failure_code") @db.VarChar(48)
  idempotencyKeyDigest String?  @map("idempotency_key_digest") @db.VarChar(64)
  createdAt            DateTime @default(now()) @map("created_at")
  payment              Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, attempt])
  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

/// Every verified callback is recorded before it is acted on. The provider
/// event identifier is unique, so a duplicate delivery is acknowledged and
/// ignored instead of capturing twice.
model PaymentWebhookInbox {
  id               String    @id @db.Uuid
  provider         String    @db.VarChar(24)
  providerEventId  String    @map("provider_event_id") @db.VarChar(120)
  providerIntentId String    @map("provider_intent_id") @db.VarChar(120)
  paymentId        String?   @map("payment_id") @db.Uuid
  eventType        String    @map("event_type") @db.VarChar(48)
  payloadDigest    String    @map("payload_digest") @db.VarChar(64)
  result           String    @db.VarChar(32)
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")
  payment          Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId, receivedAt])
  @@map("payment_webhook_inbox")
}

/// A compensation record. It never rewrites the capture it refers to: money
/// that moved stays recorded, and this row is the obligation to return it.
model Refund {
  id               String       @id @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  sessionId        String       @map("session_id") @db.Uuid
  provider         String       @db.VarChar(24)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(120)
  reason           String       @db.VarChar(32)
  amountMinor      Int          @map("amount_minor")
  currency         String       @db.Char(3)
  currencyExponent Int          @map("currency_exponent")
  status           String       @db.VarChar(24)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")
  completedAt      DateTime?    @map("completed_at")
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  session          PrintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([paymentId, reason])
  @@index([status, createdAt])
  @@map("refunds")
}

/// One paid session's print job. The manifest, the counts and the money it was
/// paid with are frozen at creation: triggers refuse to rewrite the snapshot,
/// refuse a job without a capture applied to its own session, and refuse to
/// move a settled job. There is at most one per session.
model PrintJob {
  id                   String               @id @db.Uuid
  sessionId            String               @map("session_id") @db.Uuid
  kioskId              String               @map("kiosk_id") @db.VarChar(64)
  quoteId              String               @map("quote_id") @db.Uuid
  paymentId            String               @map("payment_id") @db.Uuid
  settingsRevision     Int                  @map("settings_revision")
  settingsManifestHash String               @map("settings_manifest_hash") @db.VarChar(64)
  jobManifest          Json                 @map("job_manifest")
  jobManifestHash      String               @map("job_manifest_hash") @db.VarChar(64)
  status               String               @db.VarChar(24)
  /// Acceptance by a queue is not proof that paper came out. UNCONFIRMED is a
  /// real answer and is never rounded up to a success.
  resultConfidence     String               @default("UNKNOWN") @map("result_confidence") @db.VarChar(16)
  failureCode          String?              @map("failure_code") @db.VarChar(48)
  warningCode          String?              @map("warning_code") @db.VarChar(32)
  /// Development only; a production configuration cannot set it.
  simulatedOutcome     String?              @map("simulated_outcome") @db.VarChar(32)
  /// Set once by retention, when the per-document digests in `jobManifest` are
  /// replaced by a count. The manifest hash and the outcome stay: what was paid
  /// for and what the device reported is evidence; which files it was is not.
  manifestRedactedAt   DateTime?            @map("manifest_redacted_at")
  copies               Int
  printedSides         Int                  @map("printed_sides")
  physicalSheets       Int                  @map("physical_sheets")
  sheetsProduced       Int?                 @map("sheets_produced")
  dispatchAttempts     Int                  @default(0) @map("dispatch_attempts")
  availableAt          DateTime             @default(now()) @map("available_at")
  deadlineAt           DateTime             @map("deadline_at")
  cancelRequestedAt    DateTime?            @map("cancel_requested_at")
  createdByActorType   String               @map("created_by_actor_type") @db.VarChar(32)
  createdByActorId     String               @map("created_by_actor_id") @db.VarChar(100)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at")
  dispatchedAt         DateTime?            @map("dispatched_at")
  startedAt            DateTime?            @map("started_at")
  completedAt          DateTime?            @map("completed_at")
  failedAt             DateTime?            @map("failed_at")
  session              PrintSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kiosk                Kiosk                @relation(fields: [kioskId], references: [id], onDelete: Restrict)
  payment              Payment              @relation(fields: [paymentId, sessionId], references: [id, sessionId], onDelete: Restrict)
  quote                PriceQuote           @relation(fields: [quoteId, sessionId], references: [id, sessionId], onDelete: Restrict)
  settings             PrintSettingRevision @relation(fields: [sessionId, settingsRevision], references: [sessionId, revision], onDelete: Restrict)
  events               PrintJobEvent[]
  commands             AgentCommand[]
  recoveryResolution   PrintJobRecoveryResolution?

  @@unique([sessionId], map: "print_jobs_one_per_session_idx")
  @@index([status, availableAt])
  @@index([status, deadlineAt])
  @@index([kioskId, createdAt])
  @@map("print_jobs")
}

/// What a person saw at the tray for a job the system refused to guess about.
///
/// This is a new fact, not an edit. `print_jobs` records what the device
/// reported and triggers refuse to rewrite it, so a human observation is stored
/// beside that record rather than over it — which is also why an operator can
/// never turn an ambiguous print into a success.
///
/// One per job, and append-only. A mistaken observation stays visible and is
/// answered by a later decision with more authority, because an operator who
/// could rewrite their own account of a paid print could hide one.
///
/// It cannot move money. `refundSuggested` is a note for whoever holds
/// `refund.authorize`; the obligation itself lives in `refunds`, which the role
/// that writes this table holds no privilege on at all.
model PrintJobRecoveryResolution {
  id                String       @id @db.Uuid
  printJobId        String       @unique @map("print_job_id") @db.Uuid
  /// Denormalized from the job and checked against it by a trigger. The read
  /// side scopes an Operator by this column, so a wrong value here would be a
  /// way to see another kiosk's work.
  sessionId         String       @map("session_id") @db.Uuid
  kioskId           String       @map("kiosk_id") @db.VarChar(64)
  outcome           String       @db.VarChar(32)
  /// Mandatory, operator-written, and bounded. It cannot name a document: the
  /// people who write it are never shown a filename.
  reason            String       @db.VarChar(280)
  /// Derived from the outcome and pinned by a check constraint, so the two can
  /// never disagree about whether a person thought money was owed.
  refundSuggested   Boolean      @map("refund_suggested")
  /// What the operator counted, when they could count. Null is a real answer.
  observedSheets    Int?         @map("observed_sheets")
  resolvedByAdminId String       @map("resolved_by_admin_id") @db.Uuid
  /// The role held at the time. Roles change; evidence should not need a join
  /// to a mutable row to be read years later.
  resolvedByRole    String       @map("resolved_by_role") @db.VarChar(24)
  /// Digest of the submitted outcome and reason. A repeat of the same request
  /// replays the stored answer; a different one is refused rather than ignored.
  requestDigest     String       @map("request_digest") @db.VarChar(64)
  createdAt         DateTime     @default(now()) @map("created_at")
  printJob          PrintJob     @relation(fields: [printJobId], references: [id], onDelete: Restrict)
  session           PrintSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  resolvedBy        AdminUser    @relation(fields: [resolvedByAdminId], references: [id], onDelete: Restrict)

  @@index([kioskId, createdAt])
  @@index([refundSuggested, createdAt])
  @@map("print_job_recovery_resolutions")
}

/// The operation ledger. Append-only: what the device said is evidence, and a
/// retry writes the next entry rather than rewriting the previous one.
model PrintJobEvent {
  id          String   @id @db.Uuid
  printJobId  String   @map("print_job_id") @db.Uuid
  sequence    Int
  type        String   @db.VarChar(32)
  operationId String?  @map("operation_id") @db.Uuid
  status      String   @db.VarChar(24)
  confidence  String?  @db.VarChar(16)
  failureCode String?  @map("failure_code") @db.VarChar(48)
  warningCode String?  @map("warning_code") @db.VarChar(32)
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  printJob    PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)

  @@unique([printJobId, sequence])
  @@index([printJobId, createdAt])
  @@map("print_job_events")
}

/// Durable work for a kiosk agent. The kiosk opens no inbound port: it leases
/// a command over its own outbound connection and reports the result back.
/// The operation identifier is stable across redeliveries, so a device that
/// already saw it can recognise it rather than printing twice.
model AgentCommand {
  id              String        @id @db.Uuid
  kioskId         String        @map("kiosk_id") @db.VarChar(64)
  sessionId       String?       @map("session_id") @db.Uuid
  printJobId      String?       @map("print_job_id") @db.Uuid
  operationId     String        @unique @map("operation_id") @db.Uuid
  type            String        @db.VarChar(32)
  status          String        @db.VarChar(24)
  payload         Json
  attempts        Int           @default(0)
  availableAt     DateTime      @default(now()) @map("available_at")
  claimToken      String?       @unique @map("claim_token") @db.Uuid
  claimedAt       DateTime?     @map("claimed_at")
  leaseExpiresAt  DateTime?     @map("lease_expires_at")
  expiresAt       DateTime      @map("expires_at")
  resultCode      String?       @map("result_code") @db.VarChar(48)
  completedAt     DateTime?     @map("completed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")
  kiosk           Kiosk         @relation(fields: [kioskId], references: [id], onDelete: Cascade)
  session         PrintSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  printJob        PrintJob?     @relation(fields: [printJobId], references: [id], onDelete: Cascade)

  @@unique([printJobId], map: "agent_commands_one_per_print_job_idx")
  @@index([kioskId, status, availableAt])
  @@index([status, leaseExpiresAt])
  @@map("agent_commands")
}

