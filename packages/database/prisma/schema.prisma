generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model SystemMetadata {
  key       String   @id @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_metadata")
}

model Kiosk {
  id                  String            @id @db.VarChar(64)
  publicCode          String            @unique @map("public_code") @db.VarChar(64)
  name                String            @db.VarChar(160)
  status              String            @default("ACTIVE") @db.VarChar(32)
  timezone            String            @default("Asia/Yerevan") @db.VarChar(64)
  capabilities        Json
  capabilitiesVersion Int               @default(1) @map("capabilities_version")
  configVersion       Int               @default(1) @map("config_version")
  lastSeenAt          DateTime?         @map("last_seen_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  credentials         KioskCredential[]
  sessions            PrintSession[]
  auditEvents         AuditEvent[]
  sessionEvents       SessionEvent[]

  @@index([status])
  @@index([lastSeenAt])
  @@map("kiosks")
}

model KioskCredential {
  id           String    @id @db.Uuid
  kioskId      String    @map("kiosk_id") @db.VarChar(64)
  credentialId String    @unique @map("credential_id") @db.VarChar(100)
  secretDigest String    @unique @map("secret_digest") @db.VarChar(64)
  scopes       String[]
  issuedAt     DateTime  @default(now()) @map("issued_at")
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  kiosk        Kiosk     @relation(fields: [kioskId], references: [id], onDelete: Cascade)

  @@index([kioskId, revokedAt])
  @@map("kiosk_credentials")
}

model PrintSession {
  id                      String                 @id @db.Uuid
  publicId                String                 @unique @map("public_id") @db.VarChar(80)
  kioskId                 String                 @map("kiosk_id") @db.VarChar(64)
  locale                  String                 @db.VarChar(10)
  state                   String                 @db.VarChar(40)
  stateVersion            Int                    @default(1) @map("state_version")
  eventSequence           Int                    @default(1) @map("event_sequence")
  currentSettingsRevision Int?                   @map("current_settings_revision")
  activeQuoteId           String?                @unique @map("active_quote_id") @db.Uuid
  idleExpiresAt           DateTime               @map("idle_expires_at")
  hardExpiresAt           DateTime               @map("hard_expires_at")
  terminalReason          String?                @map("terminal_reason") @db.VarChar(80)
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @default(now()) @updatedAt @map("updated_at")
  canceledAt              DateTime?              @map("canceled_at")
  expiredAt               DateTime?              @map("expired_at")
  completedAt             DateTime?              @map("completed_at")
  kiosk                   Kiosk                  @relation(fields: [kioskId], references: [id], onDelete: Restrict)
  activeQuote             PriceQuote?            @relation("SessionActiveQuote", fields: [activeQuoteId], references: [id], onDelete: SetNull)
  uploadGrants            SessionUploadGrant[]
  mobileClients           MobileClient[]
  uploadedFiles           UploadedFile[]
  settingRevisions        PrintSettingRevision[]
  priceQuotes             PriceQuote[]           @relation("SessionQuotes")
  payments                Payment[]
  refunds                 Refund[]
  auditEvents             AuditEvent[]
  outboxEvents            OutboxEvent[]
  sessionEvents           SessionEvent[]

  @@index([kioskId, createdAt])
  @@index([state, idleExpiresAt])
  @@index([state, hardExpiresAt])
  @@map("print_sessions")
}

/// Append-only. A quote, a payment, and a print job all refer to one exact
/// revision, so a row here is never updated after it is written.
model PrintSettingRevision {
  id                 String       @id @db.Uuid
  sessionId          String       @map("session_id") @db.Uuid
  revision           Int
  copies             Int
  duplex             String       @db.VarChar(16)
  paperSize          String       @map("paper_size") @db.VarChar(16)
  orientation        String       @db.VarChar(16)
  scaling            String       @db.VarChar(16)
  collate            Boolean
  colorMode          String       @map("color_mode") @db.VarChar(16)
  selections         Json
  selectedPages      Int          @map("selected_pages")
  printedSides       Int          @map("printed_sides")
  physicalSheets     Int          @map("physical_sheets")
  capabilityVersion  Int          @map("capability_version")
  manifestHash       String       @map("manifest_hash") @db.VarChar(64)
  createdByActorType String       @map("created_by_actor_type") @db.VarChar(32)
  createdByActorId   String       @map("created_by_actor_id") @db.VarChar(100)
  createdAt          DateTime     @default(now()) @map("created_at")
  session            PrintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  quotes             PriceQuote[]

  @@unique([sessionId, revision])
  @@index([sessionId, createdAt])
  @@map("print_setting_revisions")
}

/// A published rule set is immutable. Corrections create another version.
model PricingRuleSet {
  id                 String        @id @db.Uuid
  version            String        @unique @db.VarChar(40)
  scope              String        @db.VarChar(24)
  scopeRef           String        @default("") @map("scope_ref") @db.VarChar(64)
  currency           String        @db.Char(3)
  currencyExponent   Int           @map("currency_exponent")
  status             String        @db.VarChar(16)
  rounding           String        @db.VarChar(16)
  taxMode            String        @map("tax_mode") @db.VarChar(16)
  minimumApplication String        @map("minimum_application") @db.VarChar(16)
  validFrom          DateTime      @map("valid_from")
  validUntil         DateTime?     @map("valid_until")
  publishedAt        DateTime?     @map("published_at")
  archivedAt         DateTime?     @map("archived_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at")
  rules              PricingRule[]
  quotes             PriceQuote[]

  @@index([status, validFrom])
  @@map("pricing_rule_sets")
}

model PricingRule {
  id                          String         @id @db.Uuid
  ruleSetId                   String         @map("rule_set_id") @db.Uuid
  service                     String         @db.VarChar(24)
  paperSize                   String         @map("paper_size") @db.VarChar(16)
  colorMode                   String         @map("color_mode") @db.VarChar(16)
  unitAmountMinor             Int            @map("unit_amount_minor")
  duplexAdjustmentBasisPoints Int            @map("duplex_adjustment_basis_points")
  serviceFeeMinor             Int            @map("service_fee_minor")
  minimumAmountMinor          Int            @map("minimum_amount_minor")
  taxBasisPoints              Int            @map("tax_basis_points")
  priority                    Int            @default(0)
  createdAt                   DateTime       @default(now()) @map("created_at")
  ruleSet                     PricingRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([ruleSetId, service, paperSize, colorMode])
  @@map("pricing_rules")
}

model PriceQuote {
  id                     String               @id @db.Uuid
  sessionId              String               @map("session_id") @db.Uuid
  settingsRevision       Int                  @map("settings_revision")
  manifestHash           String               @map("manifest_hash") @db.VarChar(64)
  ruleSetId              String               @map("rule_set_id") @db.Uuid
  pricingVersion         String               @map("pricing_version") @db.VarChar(40)
  status                 String               @db.VarChar(16)
  currency               String               @db.Char(3)
  currencyExponent       Int                  @map("currency_exponent")
  selectedPages          Int                  @map("selected_pages")
  printedSides           Int                  @map("printed_sides")
  physicalSheets         Int                  @map("physical_sheets")
  printAmountMinor       Int                  @map("print_amount_minor")
  duplexAdjustmentMinor  Int                  @map("duplex_adjustment_minor")
  serviceFeeMinor        Int                  @map("service_fee_minor")
  minimumAdjustmentMinor Int                  @map("minimum_adjustment_minor")
  subtotalMinor          Int                  @map("subtotal_minor")
  taxMinor               Int                  @map("tax_minor")
  totalMinor             Int                  @map("total_minor")
  expiresAt              DateTime             @map("expires_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  invalidatedAt          DateTime?            @map("invalidated_at")
  invalidationReason     String?              @map("invalidation_reason") @db.VarChar(32)
  session                PrintSession         @relation("SessionQuotes", fields: [sessionId], references: [id], onDelete: Cascade)
  settings               PrintSettingRevision @relation(fields: [sessionId, settingsRevision], references: [sessionId, revision], onDelete: Cascade)
  ruleSet                PricingRuleSet       @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  activeForSession       PrintSession?        @relation("SessionActiveQuote")
  payments               Payment[]

  @@unique([id, sessionId])
  @@index([sessionId, createdAt])
  @@index([status, expiresAt])
  @@map("price_quotes")
}

/// The accounting record for one attempt to collect one quote's total.
/// Amount and currency are re-checked against the quote by a trigger, so a
/// payment can never be stored for a price the control plane did not issue.
model Payment {
  id                 String                @id @db.Uuid
  sessionId          String                @map("session_id") @db.Uuid
  quoteId            String                @map("quote_id") @db.Uuid
  provider           String                @db.VarChar(24)
  providerIntentId   String                @map("provider_intent_id") @db.VarChar(120)
  status             String                @db.VarChar(24)
  amountMinor        Int                   @map("amount_minor")
  currency           String                @db.Char(3)
  currencyExponent   Int                   @map("currency_exponent")
  settingsRevision   Int                   @map("settings_revision")
  manifestHash       String                @map("manifest_hash") @db.VarChar(64)
  failureCode        String?               @map("failure_code") @db.VarChar(48)
  createdByActorType String                @map("created_by_actor_type") @db.VarChar(32)
  createdByActorId   String                @map("created_by_actor_id") @db.VarChar(100)
  expiresAt          DateTime              @map("expires_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at")
  authorizedAt       DateTime?             @map("authorized_at")
  capturedAt         DateTime?             @map("captured_at")
  failedAt           DateTime?             @map("failed_at")
  session            PrintSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  quote              PriceQuote            @relation(fields: [quoteId, sessionId], references: [id, sessionId], onDelete: Restrict)
  attempts           PaymentAttempt[]
  webhookEvents      PaymentWebhookInbox[]
  refunds            Refund[]

  @@unique([id, sessionId])
  @@unique([provider, providerIntentId])
  @@index([sessionId, createdAt])
  @@index([status, expiresAt])
  @@map("payments")
}

/// One row per provider interaction. Append-only: a retry writes the next
/// attempt rather than rewriting the previous one.
model PaymentAttempt {
  id                   String   @id @db.Uuid
  paymentId            String   @map("payment_id") @db.Uuid
  attempt              Int
  action               String   @db.VarChar(24)
  status               String   @db.VarChar(24)
  providerReference    String?  @map("provider_reference") @db.VarChar(120)
  failureCode          String?  @map("failure_code") @db.VarChar(48)
  idempotencyKeyDigest String?  @map("idempotency_key_digest") @db.VarChar(64)
  createdAt            DateTime @default(now()) @map("created_at")
  payment              Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, attempt])
  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

/// Every verified callback is recorded before it is acted on. The provider
/// event identifier is unique, so a duplicate delivery is acknowledged and
/// ignored instead of capturing twice.
model PaymentWebhookInbox {
  id               String    @id @db.Uuid
  provider         String    @db.VarChar(24)
  providerEventId  String    @map("provider_event_id") @db.VarChar(120)
  providerIntentId String    @map("provider_intent_id") @db.VarChar(120)
  paymentId        String?   @map("payment_id") @db.Uuid
  eventType        String    @map("event_type") @db.VarChar(48)
  payloadDigest    String    @map("payload_digest") @db.VarChar(64)
  result           String    @db.VarChar(32)
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")
  payment          Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId, receivedAt])
  @@map("payment_webhook_inbox")
}

/// A compensation record. It never rewrites the capture it refers to: money
/// that moved stays recorded, and this row is the obligation to return it.
model Refund {
  id               String       @id @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  sessionId        String       @map("session_id") @db.Uuid
  provider         String       @db.VarChar(24)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(120)
  reason           String       @db.VarChar(32)
  amountMinor      Int          @map("amount_minor")
  currency         String       @db.Char(3)
  currencyExponent Int          @map("currency_exponent")
  status           String       @db.VarChar(24)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")
  completedAt      DateTime?    @map("completed_at")
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  session          PrintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([paymentId, reason])
  @@index([status, createdAt])
  @@map("refunds")
}

model SessionUploadGrant {
  id              String        @id @db.Uuid
  sessionId       String        @map("session_id") @db.Uuid
  tokenDigest     String        @unique @map("token_digest") @db.VarChar(64)
  shortCodeDigest String        @map("short_code_digest") @db.VarChar(64)
  status          String        @default("ACTIVE") @db.VarChar(24)
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  claimedClientId String?       @map("claimed_client_id") @db.Uuid
  claimedAt       DateTime?     @map("claimed_at")
  revokedAt       DateTime?     @map("revoked_at")
  session         PrintSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  claimedClient   MobileClient? @relation("ClaimedUploadGrant", fields: [claimedClientId, sessionId], references: [id, sessionId], onDelete: Restrict)

  @@unique([claimedClientId, sessionId])
  @@index([sessionId, status])
  @@map("session_upload_grants")
}

model MobileClient {
  id                String              @id @db.Uuid
  sessionId         String              @map("session_id") @db.Uuid
  cookieDigest      String              @unique @map("cookie_digest") @db.VarChar(64)
  clientNonceDigest String              @map("client_nonce_digest") @db.VarChar(64)
  status            String              @default("ACTIVE") @db.VarChar(24)
  expiresAt         DateTime            @map("expires_at")
  lastSeenAt        DateTime?           @map("last_seen_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  revokedAt         DateTime?           @map("revoked_at")
  session           PrintSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  claimedGrant      SessionUploadGrant? @relation("ClaimedUploadGrant")
  uploadedFiles     UploadedFile[]

  @@unique([id, sessionId])
  @@unique([sessionId, clientNonceDigest])
  @@index([sessionId, status])
  @@index([status, expiresAt])
  @@map("mobile_clients")
}

model UploadedFile {
  id                       String           @id @db.Uuid
  sessionId                String           @map("session_id") @db.Uuid
  uploadedByClientId       String           @map("uploaded_by_client_id") @db.Uuid
  clientFileId             String           @map("client_file_id") @db.Uuid
  ordinal                  Int
  displayName              String           @map("display_name") @db.VarChar(160)
  status                   String           @db.VarChar(24)
  kind                     String?          @db.VarChar(12)
  declaredMime             String?          @map("declared_mime") @db.VarChar(100)
  detectedMime             String?          @map("detected_mime") @db.VarChar(100)
  extension                String?          @db.VarChar(10)
  reservedBytes            Int              @map("reserved_bytes")
  sizeBytes                Int?             @map("size_bytes")
  contentSha256            String?          @map("content_sha256") @db.VarChar(64)
  quarantineObjectKey      String?          @unique @map("quarantine_object_key") @db.VarChar(512)
  rejectionCode            String?          @map("rejection_code") @db.VarChar(80)
  processingRevision       Int              @default(1) @map("processing_revision")
  processingGeneration     Int              @default(0) @map("processing_generation")
  processingAttempts       Int              @default(0) @map("processing_attempts")
  processingAvailableAt    DateTime         @default(now()) @map("processing_available_at")
  processingEnqueuedAt     DateTime?        @map("processing_enqueued_at")
  processingClaimToken     String?          @unique @map("processing_claim_token") @db.Uuid
  processingLeaseExpiresAt DateTime?        @map("processing_lease_expires_at")
  processingStartedAt      DateTime?        @map("processing_started_at")
  processingErrorCode      String?          @map("processing_error_code") @db.VarChar(80)
  malwareScanStatus        String           @default("PENDING") @map("malware_scan_status") @db.VarChar(24)
  pageCount                Int?             @map("page_count")
  cleanupAttempts          Int              @default(0) @map("cleanup_attempts")
  cleanupDueAt             DateTime?        @map("cleanup_due_at")
  cleanupErrorCode         String?          @map("cleanup_error_code") @db.VarChar(80)
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at")
  quarantinedAt            DateTime?        @map("quarantined_at")
  readyAt                  DateTime?        @map("ready_at")
  deleteRequestedAt        DateTime?        @map("delete_requested_at")
  deletedAt                DateTime?        @map("deleted_at")
  session                  PrintSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  uploadedByClient         MobileClient     @relation(fields: [uploadedByClientId, sessionId], references: [id, sessionId], onDelete: Restrict)
  pages                    FilePage[]
  derivatives              FileDerivative[]

  @@unique([sessionId, clientFileId])
  @@unique([sessionId, ordinal])
  @@index([sessionId, status, ordinal])
  @@index([status, updatedAt])
  @@index([status, processingAvailableAt, createdAt])
  @@index([status, processingLeaseExpiresAt])
  @@index([cleanupDueAt])
  @@map("uploaded_files")
}

model FilePage {
  id                  String         @id @db.Uuid
  fileId              String         @map("file_id") @db.Uuid
  processingRevision  Int            @map("processing_revision")
  pageNumber          Int            @map("page_number")
  widthPixels         Int            @map("width_pixels")
  heightPixels        Int            @map("height_pixels")
  previewDerivativeId String         @map("preview_derivative_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at")
  file                UploadedFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)
  previewDerivative   FileDerivative @relation("FilePagePreview", fields: [previewDerivativeId, fileId, processingRevision, pageNumber], references: [id, fileId, processingRevision, pageNumber], onDelete: Restrict)

  @@unique([fileId, processingRevision, pageNumber])
  @@unique([previewDerivativeId, fileId, processingRevision, pageNumber])
  @@index([fileId, processingRevision])
  @@map("file_pages")
}

model FileDerivative {
  id                 String       @id @db.Uuid
  fileId             String       @map("file_id") @db.Uuid
  processingRevision Int          @map("processing_revision")
  type               String       @db.VarChar(32)
  status             String       @db.VarChar(24)
  pageNumber         Int          @default(0) @map("page_number")
  objectKey          String       @unique @map("object_key") @db.VarChar(512)
  mimeType           String       @map("mime_type") @db.VarChar(100)
  sizeBytes          Int          @map("size_bytes")
  sha256             String       @db.VarChar(64)
  widthPixels        Int?         @map("width_pixels")
  heightPixels       Int?         @map("height_pixels")
  createdAt          DateTime     @default(now()) @map("created_at")
  deletedAt          DateTime?    @map("deleted_at")
  file               UploadedFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  previewForPage     FilePage?    @relation("FilePagePreview")

  @@unique([id, fileId, processingRevision, pageNumber])
  @@unique([fileId, type, processingRevision, pageNumber])
  @@index([fileId, processingRevision, status])
  @@index([status, createdAt])
  @@map("file_derivatives")
}

model AuditEvent {
  id         String        @id @db.Uuid
  occurredAt DateTime      @default(now()) @map("occurred_at")
  actorType  String        @map("actor_type") @db.VarChar(32)
  actorId    String        @map("actor_id") @db.VarChar(100)
  kioskId    String?       @map("kiosk_id") @db.VarChar(64)
  sessionId  String?       @map("session_id") @db.Uuid
  action     String        @db.VarChar(100)
  outcome    String        @db.VarChar(32)
  requestId  String?       @map("request_id") @db.VarChar(100)
  metadata   Json?
  kiosk      Kiosk?        @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  session    PrintSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([sessionId, occurredAt])
  @@index([actorType, actorId, occurredAt])
  @@map("audit_events")
}

model OutboxEvent {
  id              String       @id @db.Uuid
  aggregateType   String       @map("aggregate_type") @db.VarChar(50)
  aggregateId     String       @map("aggregate_id") @db.Uuid
  sequence        Int
  type            String       @db.VarChar(100)
  payload         Json
  status          String       @default("PENDING") @db.VarChar(24)
  publishAttempts Int          @default(0) @map("publish_attempts")
  availableAt     DateTime     @default(now()) @map("available_at")
  lockedAt        DateTime?    @map("locked_at")
  claimToken      String?      @map("claim_token") @db.Uuid
  lastErrorCode   String?      @map("last_error_code") @db.VarChar(80)
  createdAt       DateTime     @default(now()) @map("created_at")
  publishedAt     DateTime?    @map("published_at")
  session         PrintSession @relation(fields: [aggregateId], references: [id], onDelete: Cascade)

  @@unique([aggregateId, sequence])
  @@index([status, availableAt, createdAt])
  @@map("outbox_events")
}

model SessionEvent {
  id         String       @id @db.Uuid
  sessionId  String       @map("session_id") @db.Uuid
  kioskId    String       @map("kiosk_id") @db.VarChar(64)
  sequence   Int
  type       String       @db.VarChar(100)
  payload    Json
  occurredAt DateTime     @map("occurred_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  session    PrintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kiosk      Kiosk        @relation(fields: [kioskId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([kioskId, occurredAt])
  @@index([sessionId, sequence])
  @@map("session_events")
}

model IdempotencyRecord {
  id             String   @id @db.Uuid
  actorId        String   @map("actor_id") @db.VarChar(100)
  action         String   @db.VarChar(100)
  keyDigest      String   @map("key_digest") @db.VarChar(64)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  resourceId     String?  @map("resource_id") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([actorId, action, keyDigest])
  @@index([expiresAt])
  @@map("idempotency_records")
}
